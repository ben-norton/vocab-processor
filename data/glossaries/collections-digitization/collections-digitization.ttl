    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/space-science>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Space Science"@en ;
    skos:definition          """Space science encompasses all of the scientific disciplines that involve space exploration and study natural phenomena and physical bodies occurring in outer space, such as space medicine and astrobiology."""@en ;
    skos:scopeNote           "Subclass of Earth Science"@en ;
    skos:notation            "space-science" ;
    dcterms:identifier       "space-science" ;
    dcterms:source           "Modern Science Ontology" ;
    rdfs:seeAlso             <https://w3id.org/skgo/modsci#SpaceScience> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/specialized-material-entity>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Specialized Material Entity"@en ;
    skos:definition          """A specialized material entity is a material entity that is defined by having some quality, role or capability."""@en ;
    skos:notation            "specialized-material-entity" ;
    dcterms:identifier       "specialized-material-entity" ;
    dcterms:source           "Semanticscience Integrated Ontology" ;
    rdfs:seeAlso             <http://semanticscience.org/resource/SIO_010410> ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/sample>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Sample"@en ;
    skos:definition          """A material entity that represents a specific known entity (feature of interest)"""@en ;

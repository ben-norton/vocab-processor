# Geological Specimen Material Category — SKOS Mappings
# Source: GeologicalSpecimenMaterialCategories.xlsx
# Generated: 2026-07-01
#
# This file contains only SKOS match triples.
# The main vocabulary file carries full concept metadata.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# ============================================================================
# Mappings
# ============================================================================

<https://kos.resources.org/def/geological-specimen-material-category/astromaterial>
    a                   skos:Concept ;
    skos:prefLabel      "Astromaterial"@en ;
    skos:narrowMatch    <https://kos.resources.org/def/geological-specimen-material-category/meteorite> ,
                        <https://kos.resources.org/def/geological-specimen-material-category/interstellar-material> .

<https://kos.resources.org/def/geological-specimen-material-category/fossil>
    a                   skos:Concept ;
    skos:prefLabel      "Fossil"@en ;
    skos:closeMatch     <https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fossil> ;
    skos:narrowMatch    <https://kos.resources.org/def/geological-specimen-material-category/trace-fossil> .

<https://kos.resources.org/def/geological-specimen-material-category/geological-material>
    a                   skos:Concept ;
    skos:prefLabel      "Geological Material"@en ;
    skos:narrowMatch    <https://kos.resources.org/def/geological-specimen-material-category/mineral> ,
                        <https://kos.resources.org/def/geological-specimen-material-category/rock> ,
                        <https://kos.resources.org/def/geological-specimen-material-category/ore> ,
                        <https://kos.resources.org/def/geological-specimen-material-category/astromaterial> ,
                        <https://kos.resources.org/def/geological-specimen-material-category/unconsolidate-material> .

<https://kos.resources.org/def/geological-specimen-material-category/meteorite>
    a                   skos:Concept ;
    skos:prefLabel      "Meteorite"@en ;
    skos:closeMatch     <https://pid.geoscience.gov.au/def/voc/ga/materialtype/meteorite> .

<https://kos.resources.org/def/geological-specimen-material-category/mineral>
    a                   skos:Concept ;
    skos:prefLabel      "Mineral"@en ;
    skos:exactMatch     <https://pid.geoscience.gov.au/def/voc/ga/materialtype/mineral> ,
                        <https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/mineralSpecimen> ;
    skos:closeMatch     <https://pid.geoscience.gov.au/def/voc/ga/materialtype/mineral> ;
    skos:narrowMatch    <https://kos.resources.org/def/geological-specimen-material-category/synthetic-mineral> ,
                        <https://kos.resources.org/def/geological-specimen-material-category/gemstone> .

<https://kos.resources.org/def/geological-specimen-material-category/rock>
    a                   skos:Concept ;
    skos:prefLabel      "Rock"@en ;
    skos:exactMatch     <https://w3id.org/gso/1.0/rockmaterial/Rock> ,
                        <https://pid.geoscience.gov.au/def/voc/ga/materialtype/rock> .

<https://kos.resources.org/def/geological-specimen-material-category/unconsolidated-material>
    a                   skos:Concept ;
    skos:prefLabel      "Unconsolidated Material"@en ;
    skos:exactMatch     <https://w3id.org/gso/1.0/rockmaterial/Unconsolidated_Material> ;
    skos:narrowMatch    <https://w3id.org/gso/1.0/rockmaterial/Natural_Unconsolidated_Material> .

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-collector>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Data Collector"@en ;
    skos:definition          """Person/institution responsible for finding or gathering/collecting data"""@en ;
    skos:notation            "data-collector" ;
    dcterms:identifier       "data-collector" ;
    dcterms:source           "Adopted from http://w3id.org/nfdi4ing/metadata4ing#DataCollector" ;

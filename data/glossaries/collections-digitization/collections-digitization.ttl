<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/semantic-interoperability>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Semantic Interoperability"@en ;
    skos:definition          """The capability of different information systems to communicate information consistent with the intended meaning, which encompasses the data structure elements involved, the terminology appearing as data and the associated identifiers"""@en ;
    skos:notation            "semantic-interoperability" ;
    dcterms:identifier       "semantic-interoperability" ;
    dcterms:source           "CIDOC Conceptual Reference Model version 7.1.3" ;
    rdfs:seeAlso             <https://cidoc-crm.org/sites/default/files/cidoc_crm_version_7.1.3.pdf> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/serial-workflow>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Serial Workflow"@en ;
    skos:definition          """A workflow whose tasks are carried in a sequence defined in a planned process"""@en ;
    skos:notation            "serial-workflow" ;
    dcterms:identifier       "serial-workflow" ;
    dcterms:source           "Elementary Multiperspective Material Ontology" ;
    rdfs:seeAlso             <https://w3id.org/emmo#EMMO_57ba1bf0_4314_432c_a9bb_6a6720c8dab5> ;

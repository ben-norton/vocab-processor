    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/specification>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Specification"@en ;
    skos:definition          """A specification is a description of the essential technical attributes/requirements for an object or procedure, and may be used to determine that the object / procedure meets its requirements/attributes."""@en ;
    skos:notation            "specification" ;
    dcterms:identifier       "specification" ;
    dcterms:source           "Semanticscience Integrated Ontology" ;
    rdfs:seeAlso             <http://semanticscience.org/resource/SIO_000090> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/specimen>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Specimen"@en ;
    skos:definition          """A material entity that represents a generalized population or kind of something defined within some context."""@en ;
    skos:scopeNote           "Within the context of museum collections, specimens are collection objects commonly collected with the intent to provide information about the population or source entity it represents."@en ;
    skos:notation            "specimen" ;
    dcterms:identifier       "specimen" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/step>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Step"@en ;
    skos:definition          """An atomic unit of a workflow plan that describes a specific task performed by an Agent"""@en ;
    skos:scopeNote           "A workflow step usually involves some input information, material or energy needed to complete the step, and some output information, material or energy produced by that step."@en ;
    skos:notation            "step" ;
    dcterms:identifier       "step" ;
    dcterms:source           "Adopted from ISO 12651-2:2014, http://purl.org/spar/pwo/Step" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/subprocess>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Subprocess"@en ;
    skos:definition          """A process that is included within another Process."""@en ;
    skos:notation            "subprocess" ;
    dcterms:identifier       "subprocess" ;
    dcterms:source           "BPMN Based Ontology" ;
    rdfs:seeAlso             <https://www.irit.fr/recherches/MELODI/ontologies/BBO#SubProcess> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/task>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Task"@en ;
    skos:definition          """An atomic unit of a task in a workflow procedure where one or more distinct, clearly defined actions are performed and may be characterized by a starting and ending time"""@en ;
    skos:scopeNote           "The concept of task is developed in strict connection with the concept of workflow: a task is always part of a workflow and a workflow always possess some tasks. This makes the relation between task and workflow an holistic relation, with task as role and workflow as whole."@en ;
    skos:notation            "task" ;
    dcterms:identifier       "task" ;
    dcterms:source           "This Document, Usage notes adopted from https://w3id.org/emmo#EMMO_4299e344_a321_4ef2_a744_bacfcce80afc and https://www.irit.fr/recherches/MELODI/ontologies/BBO#Task" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/handle>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "The Handle system"@en ;
    skos:definition          """The Handle System provides a general-purpose global name service enabling secure name resolution over the Internet, designed to enable a broad set of communities to use the technology to identify digital content independent of location. The DOI system utilises the Handle System as one component in building an added value application, for the persistent, semantically interoperable, identification of intellectual property entities. Notation: Handle"""@en ;
    skos:notation            "handle" ;
    dcterms:identifier       "handle" ;
    dcterms:source           "https://www.dona.net/handle-system" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/tool>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Tool"@en ;
    skos:definition          """Physical or digital resource that helps an agent perform an action"""@en ;
    skos:notation            "tool" ;
    dcterms:identifier       "tool" ;
    dcterms:source           "Metadata4Ing: An ontology for describing the generation of research data within a scientific activity." ;
    rdfs:seeAlso             <http://w3id.org/nfdi4ing/metadata4ing#Tool> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/transaction>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Transaction"@en ;
    skos:definition          """A cooperative interaction between two agents, involving the exchange or transfer of exchangeable products, services, rights, or funds or the processing of some request by one entity on behalf of the other"""@en ;
    skos:notation            "transaction" ;
    dcterms:identifier       "transaction" ;
    dcterms:source           "Adopted from ISO/IEC TR 15067-3-8:2020 and ISO 6707-2:2017(en), 3.2.53" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/transaction-identifier>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Transaction Identifier"@en ;
    skos:definition          """A global or local identifiers for a specific transaction"""@en ;
    skos:notation            "transaction-identifier" ;
    dcterms:identifier       "transaction-identifier" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/trigger>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Trigger"@en ;
    skos:definition          """A specific event in a planned process that initializes a new workflow branch"""@en ;
    skos:scopeNote           "Newly created workflows initiated by a formalized trigger are referred to as branches."@en ;
    skos:notation            "trigger" ;
    dcterms:identifier       "trigger" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/uri>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Uniform Resource Identifier"@en ;
    skos:definition          """A Uniform Resource Identifier (URI) is a compact sequence of characters that identifies an abstract or physical resource. Notation: URI"""@en ;
    skos:example             "http://rs.tdwg.org/dwc/terms/GeologicalContext"@en ;
    skos:notation            "uri" ;
    dcterms:identifier       "uri" ;
    dcterms:source           "RFC 3986" ;
    rdfs:seeAlso             <https://datatracker.ietf.org/doc/html/rfc3986> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/urn>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Universal Resource Name"@en ;
    skos:definition          """A URI that identifies a resource by name in a particular namespace. URNs provide globally-unique names for resources as opposed to providing information about their location (URL). Notation: URN"""@en ;
    skos:example             "urn:issn:1476-4687"@en ;
    skos:notation            "urn" ;
    dcterms:identifier       "urn" ;
    dcterms:source           "RFC 8141" ;
    rdfs:seeAlso             <https://www.rfc-editor.org/rfc/rfc8141> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/uuid>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Universally Unique Identifier (Version 4)"@en ;
    skos:definition          """Most commonly used universal identifier for machine-readable resources Notations: UUID, GUID"""@en ;
    skos:example             "405ebddc-7bec-42f7-97fc-10dbf14004e5"@en ;
    skos:notation            "uuid" ;
    dcterms:identifier       "uuid" ;
    dcterms:source           "RFC 9562" ;
    rdfs:seeAlso             <https://www.rfc-editor.org/rfc/rfc9562> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/validation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Validation"@en ;
    skos:definition          """A planned process with objective to check that the accuracy or the quality of a claim or prediction satisfies some criteria and which is assessed by comparing with independent results"""@en ;
    skos:notation            "validation" ;
    dcterms:identifier       "validation" ;
    dcterms:source           "Ontology for Biomedical Investigations" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/OBI_0302911> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/value>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Value"@en ;
    skos:definition          """An articulation that is by social convention understood to be potentially assignable to a variable"""@en ;
    skos:notation            "value" ;
    dcterms:identifier       "value" ;
    dcterms:source           "Physicalistic Interpretation of Modelling and Simulation - Interoperability Infrastructure" ;
    rdfs:seeAlso             <http://www.molmod.info/semantics/pims-ii.ttl#Value> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/voucher-specimen>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Voucher specimen"@en ;
    skos:definition          """A specimen that physically and permanently documents data in  published literature by verifying the identity of the organism(s) used in the  study and by doing so ensures that a study which otherwise could not be  repeated can be accurately reviewed or reassessed."""@en ;
    skos:scopeNote           "Rock and  mineral specimens may serve as vouchers to document the geology of an area."@en ;
    skos:notation            "voucher-specimen" ;
    dcterms:identifier       "voucher-specimen" ;
    dcterms:source           "Master Glossary for DOI Museum Property Directives" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/workflow>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Workflow"@en ;
    skos:definition          """A recorded sequence of connected steps, which may be automated, specifying a reliably repeatable sequence of operations to be undertaken during the lifecycle of data"""@en ;
    skos:scopeNote           "A workflow is a type of prov:Activity that has at least two procedures as proper parts. A workflow may be seen as an abstract model of real work."@en ;
    skos:notation            "workflow" ;
    dcterms:identifier       "workflow" ;
    dcterms:source           "Adopted from EMMO, http://purl.org/spar/fabio/Workflow, http://purl.org/spar/pwo/Workflow" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/workflow-action>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Workflow Action"@en ;
    skos:definition          """An Event with at least one participatory Agent that executes a Task that typically defined in a Plan as part of a Workflow"""@en ;
    skos:notation            "workflow-action" ;
    dcterms:identifier       "workflow-action" ;
    dcterms:source           "DOLCE+DnS Ultralite ontology" ;
    rdfs:seeAlso             <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/workflow-branch>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Workflow Branch"@en ;
    skos:definition          """A new instance of a workflow that splits from an existing workflow triggered by a planned activity such as acquiring a new collection object from an existing one (subsampling). The new workflow runs in parallel and is optionally reconnected for mobilization purposes."""@en ;
    skos:notation            "workflow-branch" ;
    dcterms:identifier       "workflow-branch" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/workflow-event>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Workflow Event"@en ;
    skos:definition          """Something that happens during a process as part of a workflow and commonly affects the flow of the process."""@en ;
    skos:scopeNote           "Here event is generalized to cover many things in a process, including the start or end of an Activity or a change in state of a specimen"@en ;
    skos:notation            "workflow-event" ;
    dcterms:identifier       "workflow-event" ;
    dcterms:source           "Adopted from https://www.irit.fr/recherches/MELODI/ontologies/BBO#Event" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/workflow-management-system>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Workflow Management System"@en ;
    skos:definition          """A system that defines, creates and manages the execution of workflows through the use of software, running on one or more workflow engines, which is able to interpret the process definition, interact with workflow participants and, where required, invoke the use of IT tools and applications."""@en ;
    skos:notation            "workflow-management-system" ;
    dcterms:identifier       "workflow-management-system" ;
    dcterms:source           "Workflow Management Coalition Specification Document Number WFMC-TC-1011." ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/workflow-phase>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Workflow Phase"@en ;
    skos:definition          """A distinguished part of a workflow comprised of a grouping of processes based on conceptual, thematic, functional and temporal criteria"""@en ;
    skos:scopeNote           "Phases must be defined explicitly and unambiguously with minimal semantic overlap between phases belonging to the same workflow"@en ;
    skos:notation            "workflow-phase" ;
    dcterms:identifier       "workflow-phase" ;
    dcterms:source           "This Document with contributions from ISO 24635-1:2025 and ISO/TS 16710-1:2024" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/workflow-tool>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Workflow Tool"@en ;
    skos:definition          """Device, system or software used by an Agent to perform specific workflow tasks"""@en ;
    skos:notation            "workflow-tool" ;
    dcterms:identifier       "workflow-tool" ;
    dcterms:source           "Adopted from ISO/IEC 23000-15:2016" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.


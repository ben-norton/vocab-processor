# ==========================================================================
# Concepts
# ==========================================================================

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/accession-assessment>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Accession Assessment"@en ;
    skos:definition          """An activity with the goal of determining whether or not a specimen should be accessioned into a collection."""@en ;
    skos:notation            "accession-assessment" ;
    dcterms:identifier       "accession-assessment" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/accessioning>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Accessioning"@en ;
    skos:definition          """The formal, documented process to legally add an object or group of objects to a museum collection. A single accession transaction occurs when one or more objects are acquired in the same manner, from one source, and at one time."""@en ;
    skos:notation            "accessioning" ;
    dcterms:identifier       "accessioning" ;
    dcterms:source           "Master Glossary for DOI Museum Property Directives" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/acquisition>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Acquisition"@en ;
    skos:definition          """An activity with the objective of gaining physical custody of an object for a museum collection through purchase, donation, bequest, transfer, or fieldwork. This includes the associated metadata primarily derived from primary sources."""@en ;
    skos:scopeNote           "The scope of an acquisition includes any prov:Activity that results in the possession of a specimen. In contrast, accession has a specific meaning and involves the formal transfer of ownership. Acquisition is an informal custody transfer of an object by an agent. In contrast, an accession is a formal process by which the ownership of an object is transferred to a museum"@en ;
    skos:notation            "acquisition" ;
    dcterms:identifier       "acquisition" ;
    dcterms:source           "ISO 21246:2019(en), http://purl.obolibrary.org/obo/OBI_0600008, Master Glossary for DOI Museum Property Directives" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/action>

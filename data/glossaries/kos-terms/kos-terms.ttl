    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/narrower-term>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Narrower Term"@en ;
    skos:definition          """A term that is subordinate to another term or to multiple terms in a hierarchy. In thesauri, the relationship indicator for this type of term is NT."""@en ;
    skos:notation            "narrower-term" ;
    dcterms:identifier       "narrower-term" ;

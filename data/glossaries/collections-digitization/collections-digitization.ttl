    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-curation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Curation"@en ;
    skos:definition          """A planned process in which existing data is collected, organized, and improved in preparation for subsequent use."""@en ;
    skos:notation            "data-curation" ;
    dcterms:identifier       "data-curation" ;
    dcterms:source           "Ontology for Scientific Evidence and Provenance Information" ;

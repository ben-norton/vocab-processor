<https://kos.geospecimens.org/glossary/kos-terms/term/metadata-standard>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Metadata Standard"@en ;
    skos:definition          """A set of formally agreed guidelines defining the structure, content, and semantics necessary to make data understandable, discoverable, and interoperable"""@en ;
    skos:notation            "metadata-standard" ;
    dcterms:identifier       "metadata-standard" ;
    dcterms:source           "ISO 19115" ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/thesaurus>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Thesaurus"@en ;
    skos:definition          """Controlled and structured vocabulary in which concepts are represented by terms, organized so that relationships between concepts are made explicit, and preferred terms are accompanied by lead-in entries for synonyms or quasi-synonyms"""@en ;
    skos:notation            "thesaurus" ;
    dcterms:identifier       "thesaurus" ;
    dcterms:source           "ISO25964-2:2013" ;
    rdfs:seeAlso             <https://www.niso.org/schemas/iso25964> ;
    dcterms:modified         "2026-06-10"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/glossary/kos-terms> ;
    skos:topConceptOf        <https://kos.geospecimens.org/glossary/kos-terms> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/tree-structure>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Tree Structure"@en ;
    skos:definition          """A controlled vocabulary display format in which the complete hierarchy of terms is shown. Each term is assigned a tree number or line number which leads from the alphabetical display to the hierarchical one. The hierarchical display is also known as systematic display."""@en ;
    skos:notation            "tree-structure" ;
    dcterms:identifier       "tree-structure" ;
    dcterms:source           "ANSI/NISO Z39.19-2005" ;
    rdfs:seeAlso             <https://www.niso.org/publications/ansiniso-z3919-2005-r2010> ;
    dcterms:modified         "2026-06-10"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/glossary/kos-terms> ;
    skos:topConceptOf        <https://kos.geospecimens.org/glossary/kos-terms> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/type-vocabulary>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Type Vocabulary"@en ;
    skos:definition          """An atomized set of terms that characterize the nature of a resource"""@en ;
    skos:notation            "type-vocabulary" ;
    dcterms:identifier       "type-vocabulary" ;
    dcterms:modified         "2026-06-10"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/glossary/kos-terms> ;
    skos:topConceptOf        <https://kos.geospecimens.org/glossary/kos-terms> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/uncontrolled-vocabulary>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Uncontrolled Vocabulary"@en ;
    skos:definition          """A non-defined collection of words and phrases relating to a particular domain of knowledge, usually added freely by a community, in which homonyms, synonyms and similar ambiguities of meaning present in natural language are not formally disambiguated."""@en ;
    skos:notation            "uncontrolled-vocabulary" ;
    dcterms:identifier       "uncontrolled-vocabulary" ;
    dcterms:source           "FaBiO" ;
    rdfs:seeAlso             <http://www.sparontologies.net/ontologies/fabio> ;
    dcterms:modified         "2026-06-10"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/glossary/kos-terms> ;
    skos:topConceptOf        <https://kos.geospecimens.org/glossary/kos-terms> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/value-domain>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Value Domain"@en ;
    skos:definition          """A resource type used to denote a collection of permissible values associated with a conceptual domain or term in a controlled vocabulary."""@en ;
    skos:scopeNote           "Synonyms include codelist, value list, pick list, enumerated domain, and enumerated value set. Also defined in ISO/IEC 11179-3 as a class each instance of which models a value domain — a set of permissible values — providing representation without implication as to the associated Data Element Concept."@en ;
    skos:notation            "value-domain" ;
    dcterms:identifier       "value-domain" ;
    dcterms:source           "Aristotle" ;
    rdfs:seeAlso             <https://aristotle.cloud/help/concepts/aristotle_mdr/valuedomain> ;
    dcterms:modified         "2026-06-10"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/glossary/kos-terms> ;
    skos:topConceptOf        <https://kos.geospecimens.org/glossary/kos-terms> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/http-purl-org-spar-fabio-vocabulary>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Vocabulary"@en ;
    skos:definition          """Terminological dictionary which contains designations and definitions for one or more specific subject fields."""@en ;
    skos:scopeNote           "Also defined as: a set of words constituting a language or used to describe a particular domain of knowledge (FaBiO); a collection of terms for a particular purpose (W3C LD Glossary)."@en ;
    skos:notation            "http-purl-org-spar-fabio-vocabulary" ;
    dcterms:identifier       "http-purl-org-spar-fabio-vocabulary" ;
    dcterms:source           "ISO 1087:2019" ;
    rdfs:seeAlso             <https://www.iso.org/standard/62330.html> ;
    dcterms:modified         "2026-06-10"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/glossary/kos-terms> ;
    skos:topConceptOf        <https://kos.geospecimens.org/glossary/kos-terms> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/vocabulary-mapping>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Vocabulary Mapping"@en ;
    skos:definition          """A mapping of correspondences between two vocabularies. For controlled vocabularies, such mappings may be expressed using SKOS (http://www.w3.org/2004/02/skos/)."""@en ;

.

<https://kos.geospecimens.org/glossary/kos-terms/term/ontology>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Ontology"@en ;
    skos:definition          """A formal model that allows knowledge to be represented for a specific domain. An ontology describes the types of things that exist (classes), the relationships between them (properties) and the logical ways those classes and properties can be used together (axioms)."""@en ;
    skos:notation            "ontology" ;
    dcterms:identifier       "ontology" ;
    dcterms:source           "W3C LD Glossary" ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/terminological-dictionary>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Terminological Dictionary"@en ;
    skos:definition          """Terminology resource that is designed to be used as a reference work"""@en ;

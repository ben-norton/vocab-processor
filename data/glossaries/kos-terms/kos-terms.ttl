<https://kos.geospecimens.org/glossary/kos-terms/term/http-purl-org-spar-fabio-metadata>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Metadata"@en ;
    skos:definition          """A separate work that provides information describing one or more characteristics of a resource or entity."""@en ;
    skos:notation            "http-purl-org-spar-fabio-metadata" ;
    dcterms:identifier       "http-purl-org-spar-fabio-metadata" ;

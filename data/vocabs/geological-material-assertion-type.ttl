<https://kos.geospecimens.org/def/geological-material-assertion-type/verbatim-size>
    a                        skos:Concept ;
    skos:prefLabel           "Verbatim Size"@en ;
    skos:definition          """The verbatim size of a specimen as originally described in primary source material."""@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "verbatimSize" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/measured-width-in-millimeters>
    a                        skos:Concept ;
    skos:prefLabel           "Measured Width in Millimeters"@en ;
    skos:definition          """Measured width of specimen reported numerically in millimeters."""@en ;
    vann:usageNote           "Height, width, and depth measurements should be measured along perpendicular axes from a single shared point of origin."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "measuredWidthInMillimeters" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/measured-height-in-millimeters>
    a                        skos:Concept ;
    skos:prefLabel           "Measured Height in Millimeters"@en ;
    skos:definition          """Measured height of specimen reported numerically in millimeters."""@en ;
    vann:usageNote           "Height, width, and depth measurements should be measured along perpendicular axes from a single shared point of origin."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "measuredHeightInMillimeters" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/measured-depth-in-millimeters>
    a                        skos:Concept ;
    skos:prefLabel           "Measured Depth in Millimeters"@en ;
    skos:definition          """Measured depth of specimen reported numerically in millimeters."""@en ;
    vann:usageNote           "Height, width, and depth measurements should be measured along perpendicular axes from a single shared point of origin."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "measuredDepthInMillimeters" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/maximum-axial-dimension>
    a                        skos:Concept ;
    skos:prefLabel           "Maximum Axial Dimension"@en ;
    skos:definition          """Maximum axial dimension of largest crystal measured in millimeters."""@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "maxCrystalDimensionInMillimeters" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/associated-minerals>
    a                        skos:Concept ;
    skos:prefLabel           "Associated Minerals"@en ;
    skos:definition          """List of secondary minerals associated with a mineral in a specimen."""@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "associatedMinerals" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/aggregate-form>
    a                        skos:Concept ;
    skos:prefLabel           "Aggregate Form"@en ;
    skos:definition          """Observable crystal shapes of an assemblage of minerals."""@en ;
    vann:usageNote           "Recommended best practice is to use a controlled vocabulary."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "aggregateForm" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/crystal-habit>
    a                        skos:Concept ;
    skos:prefLabel           "Crystal Habit"@en ;
    skos:definition          """A general term for describing the outward appearance of a mineral."""@en ;
    vann:usageNote           "Recommended best practice is to use a controlled vocabulary. For a given type of crystal, the habit may vary from locality to locality depending on environment of growth."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "crystalHabit" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/crystal-form>
    a                        skos:Concept ;
    skos:prefLabel           "Crystal Form"@en ;
    skos:definition          """Geometric shape of a crystal."""@en ;
    vann:usageNote           "Recommended best practice is to use a controlled vocabulary."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "crystalForm" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/twinning-law>
    a                        skos:Concept ;
    skos:prefLabel           "Twinning Law"@en ;
    skos:altLabel            "Twinning type"@en ,
                             "twinning description"@en ;
    skos:definition          """Short description of any physically discernible twinning."""@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "twinningLaw" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/color>
    a                        skos:Concept ;
    skos:prefLabel           "Color"@en ;
    skos:definition          """The intrinsic color of a geological material under natural light."""@en ;
    vann:usageNote           "Here, color is caused by the absorption, or lack of absorption of different wavelengths of natural light by a particular geological material."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "color" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/exsolution-texture>
    a                        skos:Concept ;
    skos:prefLabel           "Exsolution Texture"@en ;
    skos:definition          """A brief description of textures formed by exsolution."""@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "exsolutionTexture" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/cleavage>
    a                        skos:Concept ;
    skos:prefLabel           "Cleavage"@en ;
    skos:definition          """Type of breakages along a plane of weakness, especially those parallel to crystal faces."""@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "cleavage" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/luster>
    a                        skos:Concept ;
    skos:prefLabel           "Luster"@en ;
    skos:definition          """The reflection of light from the surface of a mineral, described by its quality and intensity."""@en ;
    vann:usageNote           "Recommended best practice is to use a controlled vocabulary such as http://kos.geospecimens.org/def/luster."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "luster" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/inclusions>
    a                        skos:Concept ;
    skos:prefLabel           "Inclusions"@en ;
    skos:definition          """Short description of any inclusions present within a mineral that includes the phase and physical characteristics."""@en ;
    vann:usageNote           "Inclusions are defined as small foreign bodies (solid, liquid, or gas) within the physical bounds of a material commonly trapped during formation."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "inclusions" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/luminescence-description>
    a                        skos:Concept ;
    skos:prefLabel           "Luminescence Description"@en ;
    skos:definition          """The type and nature of light emitted from the mineral upon receiving energy from an external source."""@en ;
    vann:usageNote           "Includes all types of luminescence including fluorescence (all wavelengths) and phosphorescence. Recommended best practice is to use nomenclature in part based on the source of energy, or the trigger for the luminescence."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "luminescence" ;
.

<https://kos.geospecimens.org/def/geological-material-assertion-type/alteration-description>
    a                        skos:Concept ;
    skos:prefLabel           "Alteration Description"@en ;
    skos:definition          """A description of any observed changes in the composition of a geological material brought about by physical or chemical processes related to changes in the physical or chemical environment."""@en ;
    dcterms:provenance       "http://linked.data.gov.au/def/geological-observation-type/alteration, http://www.opengis.net/gsml/4.1/GeoSciML-Extension"@en ;
    vann:usageNote           "Definition adopted from the concepts under term sources: http://linked.data.gov.au/def/geological-observation-type/alteration, http://www.opengis.net/gsml/4.1/GeoSciML-Extension"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-material-assertion-type> ;
    skos:notation            "alterationDescription" ;
.


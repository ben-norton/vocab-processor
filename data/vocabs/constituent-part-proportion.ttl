# ============================================================================
# ConceptScheme
# ============================================================================

<https://kos.geospecimens.org/def/constituent-part-proportion>
    a                        skos:ConceptScheme ;
    skos:prefLabel           "Constituent Part Proportion"@en ;
    dcterms:title            "Constituent Part Proportion"@en ;
    skos:definition          """The Constituent Part Proportion vocabulary is a SKOS-based terminology for describing the presence of a constituent part within the context of a parent compound specimen. The scheme provides comprehensive coverage for describing qualitative abundance."""@en ;
    dcterms:description      """The Constituent Part Proportion vocabulary is a SKOS-based terminology for describing the presence of a constituent part within the context of a parent compound specimen. The scheme provides comprehensive coverage for describing qualitative abundance."""@en ;
    dcterms:publisher        <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:creator          <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:contributor      "TDWG Mineralogy Extension Task Group"@en ;
    dcterms:provenance       "Compiled by the TDWG Mineralogy Extension Task Group for community use and to support the extension release by providing standardized values for Constituent Part proportions, which is key attribute of Constituent Parts of a Component Specimen"@en ;
    dcterms:created          "2026-04-17"^^xsd:date ;
    dcterms:modified         "2026-04-17"^^xsd:date ;
    dcat:version             "2026-04-17" ;
    skos:scopeNote           "Values are valid within the scope of a material entity comprised of physically discrenable parts unified through physical attachment or some unifying criteria"@en ;
    vann:usageNote           "Used together with Constituent Part Role to describe the nature of a Constituent Part within the context of its parent Compound Specimen."@en ;
    skos:historyNote         "Terms and definitions are largely derived from the CGI Vocabulary, Proportion Term (http://resource.geosciml.org/classifier/cgi/proportionterm), with modifications to suit the context of a curated collection of specimens at the hand-specimen level"@en ;
    dcat:keyword             "Collections"@en ,
                             "Geologic Collections"@en ,
                             "Specimens"@en ,
                             "Compound Specimen"@en ,
                             "Constituent Part"@en ;
    schema:citation          "Norton B, Walcott R, Burri T, Puschnig A, Dombrowski A, Greber N, Hints O, Mansur A, Ralph J, Richard S, Tacker C. Constituent Part Proportion Vocabulary (pending)."@en ;
    schema:license           <https://creativecommons.org/licenses/by/4.0/> ;
    reg:derivationMode       <https://linked.data.gov.au/def/vocdermods/subsetting-and-extension> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    skos:hasTopConcept       <https://kos.geospecimens.org/def/constituent-part-proportion/all> ,
                             <https://kos.geospecimens.org/def/constituent-part-proportion/major> ,
                             <https://kos.geospecimens.org/def/constituent-part-proportion/minor> ,
                             <https://kos.geospecimens.org/def/constituent-part-proportion/rare> ,
                             <https://kos.geospecimens.org/def/constituent-part-proportion/trace> ,
                             <https://kos.geospecimens.org/def/constituent-part-proportion/present> ,
                             <https://kos.geospecimens.org/def/constituent-part-proportion/variable> ,
                             <https://kos.geospecimens.org/def/constituent-part-proportion/absent> ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://kos.geospecimens.org/org/ben-norton> ;
        dcat:hadRole     isoroles:publisher , isoroles:author ;
    ] ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://kos.geospecimens.org/org/minext> ;
        dcat:hadRole     isoroles:editor , isoroles:custodian ;
    ] ;
.

# ============================================================================
# Concepts
# ============================================================================

<https://kos.geospecimens.org/def/constituent-part-proportion/all>
    a                        skos:Concept ;
    skos:prefLabel           "All"@en ;
    skos:definition          """A material component comprises the entire material entity by volume, excluding negligible impurities"""@en ;
    skos:changeNote          "Used for monomineralic specimens or materials composed of a single constituent"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    skos:closeMatch          <http://resource.geosciml.org/classifier/cgi/proportionterm/all> ;
.

<https://kos.geospecimens.org/def/constituent-part-proportion/major>
    a                        skos:Concept ;
    skos:prefLabel           "Major"@en ;
    skos:altLabel            "Dominant"@en ;
    skos:definition          """A material component comprises more than 50% of the material entity by volume"""@en ;
    skos:changeNote          "Used when a single constituent clearly forms the majority of the specimen"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    skos:closeMatch          <http://resource.geosciml.org/classifier/cgi/proportionterm/major> ;
    skos:narrowMatch         <http://resource.geosciml.org/classifier/cgi/proportionterm/dominant> ;
.

<https://kos.geospecimens.org/def/constituent-part-proportion/minor>
    a                        skos:Concept ;
    skos:prefLabel           "Minor"@en ;
    skos:altLabel            "Subordinate"@en ;
    skos:definition          """A material component comprises between 5% and 50% of the material entity by volume"""@en ;
    skos:changeNote          "Component material is readily observable but not abundant"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    skos:closeMatch          <http://resource.geosciml.org/classifier/cgi/proportionterm/subordinate> ;
    skos:narrowMatch         <http://resource.geosciml.org/classifier/cgi/proportionterm/minor> ;
.

<https://kos.geospecimens.org/def/constituent-part-proportion/rare>
    a                        skos:Concept ;
    skos:prefLabel           "Rare"@en ;
    skos:definition          """A material component comprises between 0.1% and 5% of the material entity by volume"""@en ;
    skos:changeNote          "Component material is present in very small quantities, may require careful examination to identify"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    skos:closeMatch          <http://resource.geosciml.org/classifier/cgi/proportionterm/rare> ;
.

<https://kos.geospecimens.org/def/constituent-part-proportion/trace>
    a                        skos:Concept ;
    skos:prefLabel           "Trace"@en ;
    skos:definition          """A material component comprises less than 0.1% of the material entity by volume"""@en ;
    skos:changeNote          "Component material occurs in minute quantities, typically requires magnification or analytical methods to detect"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    skos:closeMatch          <http://resource.geosciml.org/classifier/cgi/proportionterm/trace> ;
.

<https://kos.geospecimens.org/def/constituent-part-proportion/present>
    a                        skos:Concept ;
    skos:prefLabel           "Present"@en ;
    skos:definition          """A material component is confirmed to exist in the material entity but proportion has not been quantified"""@en ;
    skos:changeNote          "Applicable the presence of component material is documented but volumetric proportion cannot be determined"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    skos:closeMatch          <http://resource.geosciml.org/classifier/cgi/proportionterm/present> ;
.

<https://kos.geospecimens.org/def/constituent-part-proportion/variable>
    a                        skos:Concept ;
    skos:prefLabel           "Variable"@en ;
    skos:definition          """The proportion of a material component varies significantly within the material entity or across specimens"""@en ;
    skos:changeNote          "Applicable when the occurrence of a component material is heterogeneous or inconsistent, preventing assignment of a single proportion value"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    skos:closeMatch          <http://resource.geosciml.org/classifier/cgi/proportionterm/variable> ;
.

<https://kos.geospecimens.org/def/constituent-part-proportion/absent>
    a                        skos:Concept ;
    skos:prefLabel           "Absent"@en ;
    skos:definition          """A material component is not present in the material entity"""@en ;
    skos:changeNote          "Value should only be used to document the absence of a component material that might be expected or was previously reported"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/constituent-part-proportion> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/constituent-part-proportion> ;
.


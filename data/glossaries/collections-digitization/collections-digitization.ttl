    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/property>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Property"@en ;
    skos:definition          """A variable that can be considered (as an investigated property) within a processing step"""@en ;
    skos:notation            "property" ;
    dcterms:identifier       "property" ;
    dcterms:source           "Physicalistic Interpretation of Modelling and Simulation - Interoperability Infrastructure" ;
    rdfs:seeAlso             <http://www.molmod.info/semantics/pims-ii.ttl#Property> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/provenance>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Provenance"@en ;
    skos:definition          """Information that documents the history of a described object and related described activities, and that contains information about the origin or source of the described object, any changes that can have taken place since it was originated, and who has had custody of it since it was originated"""@en ;
    skos:scopeNote           "For scientific assertions/claims, this is the process history leading to the assertion being made, including the processes through which evidence is evaluated and the methods through which information used as evidence is created. The transitive nature of provenance means that the provenance history of information used as supporting data becomes provenance for an assertion that uses this information as evidence. Provenance metadata describes these processes, including accounts of who conducted them, what entities participated, and when/where they occurred."@en ;
    skos:notation            "provenance" ;
    dcterms:identifier       "provenance" ;
    dcterms:source           "Adopted from http://purl.obolibrary.org/obo/SEPIO_0000058, Master Glossary for DOI Museum Property Directives, ISO 24480:2024(en), and http://purl.obolibrary.org/obo/T4FS_0000309" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/provenance-statement>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Provenance Statement"@en ;
    skos:definition          """Any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation."""@en ;
    skos:notation            "provenance-statement" ;
    dcterms:identifier       "provenance-statement" ;
    dcterms:source           "DMCI Metadata Terms" ;
    rdfs:seeAlso             <http://purl.org/dc/terms/ProvenanceStatement> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/quantity-kind>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Quantity Kind"@en ;
    skos:definition          """Any observable property that can be measured and quantified numerically."""@en ;
    skos:scopeNote           "Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity."@en ;
    skos:notation            "quantity-kind" ;
    dcterms:identifier       "quantity-kind" ;
    dcterms:source           "QUDT Quantity Kind Vocabulary Version 3.1.5" ;
    rdfs:seeAlso             <http://qudt.org/schema/qudt/QuantityKind> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/registrar>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Registrar"@en ;
    skos:definition          """Person responsible for the surveilling, handling and the action(s) of physical placement of material objects in a museum"""@en ;
    skos:notation            "registrar" ;
    dcterms:identifier       "registrar" ;
    dcterms:source           "ISO 5127:2017(en) Information and documentation — Foundation and vocabulary" ;
    rdfs:seeAlso             <https://www.iso.org/standard/59743.html> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/repository>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Repository"@en ;
    skos:definition          """A Web-based resources that preserve, manage, and provide access to many types of digital materials in a variety of formats."""@en ;
    skos:notation            "repository" ;
    dcterms:identifier       "repository" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000489> ;

    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "IIE" ;
    skos:prefLabel "IIE iron group"@en .

mc:iiiab-iron-group a skos:Concept ;
    dct:identifier "iiiab-iron-group" ;
    dct:source mcref:scottwasson1975,
        mcref:wassonironseries ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:irons ;
    skos:broader mc:irons ;
    skos:definition "One of the largest magmatic iron groups (octahedrites); a single fractional-crystallization sequence (former IIIA+IIIB), with metal close to main-group-pallasite composition."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "IIIAB" ;

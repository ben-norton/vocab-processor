<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/cultural-heritage>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Cultural Heritage"@en ;
    skos:definition          """Legacy of physical objects and intangible attributes of a group or a society that are inherited from past generations, maintained and protected in the present and preserved for future generations"""@en ;
    skos:notation            "cultural-heritage" ;
    dcterms:identifier       "cultural-heritage" ;

# ============================================================================
# ConceptScheme
# ============================================================================

<https://kos.geospecimens.org/def/geological-specimen-material-category>
    a                        skos:ConceptScheme ;
    skos:prefLabel           "Geological Specimen Material Category"@en ;
    dcterms:title            "Geological Specimen Material Category"@en ;
    dcterms:description      """The Geological Sample Material Category vocabulary is a SKOS-based hierarchical classification system for geological specimens. The scheme provides comprehensive coverage of the earth sciences domain by accommodating both natural and processed materials, terrestrial and extraterrestrial sources, and the practical needs of collection management across diverse geological institutions."""@en ;
    dcterms:publisher        <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:creator          <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:contributor      "TDWG Mineralogy Extension Task Group"@en ;
    dcterms:provenance       "Compiled by the TDWG Mineralogy Extension Task Group for community use and to support the extension release by providing standardized values for Material Entity Type, which is central to the Extension and Compound Specimen Model."@en ;
    dcterms:created          "2026-04-09"^^xsd:date ;
    dcterms:modified         "2026-09-11"^^xsd:date ;
    dcat:version             "2026-09-11" ;
    skos:scopeNote           "The Geologic Specimen Material Category vocabulary is intended to provide a top-level catagorization scheme for specimens that belong to earth sciences collections. Usage beyond the scope of earth sciences collections may require adjustments or broadening of specific definitions."@en ;
    vann:usageNote           "Intended to be used with the material category terms (e.g. dwc:materialEntityType) for specimens belonging to earth sciences and astromaterials collections."@en ;
    skos:historyNote         "Change to accepted status on 20260911, Compiled by the TDWG Mineralogy Extension Task Group for community use and to support the extension release by providing standardized values for Material Entity Type, which is central to the Extension and Compound Specimen Model."@en ;
    skos:note                "Concepts in the Geologic Specimen Material Category vocabulary are distinguished by compositional and physical characteristics. Top-level terms are based primarily on composition, while child terms represent physically distinct variants."@en ;
    dcat:keyword             "Collections"@en ,
                             "Geologic Collections"@en ,
                             "Specimens"@en ,
                             "Material Entity Types"@en ;
    schema:citation          "Norton B, Walcott R, Burri T, Puschnig A, Dombrowski A, Greber N, Hints O, Mansur A, Ralph J, Richard S, Tacker C. Geological Material Sample Type Vocabulary (pending)."@en ;
    prov:wasDerivedFrom      "Geoscience Ontology, Rock TypesGeoscience Ontology, Rock Types"@en ,
                             "Rubin AE, Grossman JN (2014) Meteorite and meteoroid: a new comprehensive definition. Meteorit Planet Sci 45:114–122"@en ,
                             "Geologic Sample Material Categorys (https://linked.data.gov.au/def/geological-sample-type)"@en ,
                             "Dictionary of Geology & Mineralogy 2nd ed. (2003) McGraw Hill"@en ,
                             "Neuendorf et al. (2005)"@en ;
    schema:license           <https://creativecommons.org/licenses/by/4.0/> ;
    reg:derivationMode       <https://linked.data.gov.au/def/vocdermods/subsetting-and-extension> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:hasTopConcept       <https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material> ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://kos.geospecimens.org/org/ben-norton> ;
        dcat:hadRole     isoroles:publisher , isoroles:author ;
    ] ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://kos.geospecimens.org/org/minext> ;
        dcat:hadRole     isoroles:editor , isoroles:custodian ;
    ] ;
.

# ============================================================================
# Concepts
# ============================================================================

<https://kos.geospecimens.org/def/geological-specimen-material-category/astromaterial>
    a                        skos:Concept ;
    skos:prefLabel           "Astromaterial"@en ;
    skos:definition          """A geologic material that is extraterrestrial in origin or derived from a geological process involving an extraterrestrial material (impactite)"""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material> ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "astromaterial" ;
    skos:narrowMatch         <https://kos.geospecimens.org/def/geological-specimen-material-category/meteorite> ,
                             <https://kos.geospecimens.org/def/geological-specimen-material-category/interstellar-material> ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/fossil>
    a                        skos:Concept ;
    skos:prefLabel           "Fossil"@en ;
    skos:definition          """Any remains, trace, or imprint of a plant or animal preserved in the Earth's crust since some past geologic or prehistoric time; loosely, any evidence of past life."""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material> ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "fossil" ;
    skos:closeMatch          <https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/fossil> ;
    skos:narrowMatch         <https://kos.geospecimens.org/def/geological-specimen-material-category/trace-fossil> ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/gemstone>
    a                        skos:Concept ;
    skos:prefLabel           "Gemstone"@en ;
    skos:altLabel            "Gem"@en ;
    skos:definition          """Any mineral or naturally occurring substance that, when cut and polished, has sufficient beauty, rarity, and durability for use as a personal adornment or other ornament."""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/mineral> ;
    dcterms:provenance       "Term defined by the Geologic sample type vocabulary (https://linked.data.gov.au/def/geological-sample-type)"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "gemstone" ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material>
    a                        skos:Concept ;
    skos:prefLabel           "Geological Material"@en ;
    skos:altLabel            "Geologic Material"@en ,
                             "Earth Material"@en ,
                             "Geological Specimen Type"@en ,
                             "Material Entity Type"@en ;
    skos:definition          """A material entity comprised of a natural amount of matter generated by some geologic process, includes synthetic material intended to represent a geological material"""@en ;
    skos:editorialNote       "Can include minor parts that are not of geologic origin, such as organic material, and can be solid, fluid, or a mix."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    skos:notation            "geologicalMaterial" ;
    skos:narrowMatch         <https://kos.geospecimens.org/def/geological-specimen-material-category/mineral> ,
                             <https://kos.geospecimens.org/def/geological-specimen-material-category/rock> ,
                             <https://kos.geospecimens.org/def/geological-specimen-material-category/ore> ,
                             <https://kos.geospecimens.org/def/geological-specimen-material-category/astromaterial> ,
                             <https://kos.geospecimens.org/def/geological-specimen-material-category/unconsolidate-material> ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/meteorite>
    a                        skos:Concept ;
    skos:prefLabel           "Meteorite"@en ;
    skos:definition          """A natural, solid object, derived from a celestial body, that was transported by natural means from the body on which it formed to a region outside the dominant gravitational influence of that body and that later collided with a natural or artificial body larger than itself."""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/astromaterial> ;
    dcterms:provenance       "Definition derived from Rubin AE, Grossman JN (2014) Meteorite and meteoroid: a new comprehensive definition. Meteorit Planet Sci 45:114–122"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "meteorite" ;
    skos:closeMatch          <https://pid.geoscience.gov.au/def/voc/ga/materialtype/meteorite> ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/mineral>
    a                        skos:Concept ;
    skos:prefLabel           "Mineral"@en ;
    skos:definition          """A naturally occurring element or chemical compound of homogeneous composition, normally with a crystalline structure, and resulting from some geological process on Earth or in extraterrestrial bodies"""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material> ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "mineral" ;
    skos:closeMatch          <https://pid.geoscience.gov.au/def/voc/ga/materialtype/mineral> ;
    skos:exactMatch          <https://pid.geoscience.gov.au/def/voc/ga/materialtype/mineral> ,
                             <https://pid.geoscience.gov.au/def/voc/ga/GeologySampleType/mineralSpecimen> ;
    skos:narrowMatch         <https://kos.geospecimens.org/def/geological-specimen-material-category/synthetic-mineral> ,
                             <https://kos.geospecimens.org/def/geological-specimen-material-category/gemstone> ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/ore>
    a                        skos:Concept ;
    skos:prefLabel           "Ore"@en ;
    skos:altLabel            "Economic Mineral"@en ,
                             "Metallic Ore"@en ,
                             "Industrial Mineral"@en ,
                             "Mineral Deposit"@en ;
    skos:definition          """A naturally occurring geological material from which economically valuable minerals can be extracted."""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material> ;
    dcterms:provenance       "Definition is adopted from McGraw-Hill. (2003). McGraw-Hill Dictionary of Geology & Mineralogy (2nd ed.). McGraw Hill."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "ore" ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/rock>
    a                        skos:Concept ;
    skos:prefLabel           "Rock"@en ;
    skos:definition          """Consolidated aggregate of one or more EarthMaterials, or a body of undifferentiated mineral matter, or of solid organic material. Includes mineral aggregates such as granite, shale, marble; glassy matter such as obsidian; and organic material such a coal. Excludes unconsolidated materials."""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material> ;
    dcterms:provenance       "Geoscience Ontology, Rock TypesGeoscience Ontology, Rock Types (https://w3id.org/gso/1.0/rockmaterial/ontology)"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "rock" ;
    skos:exactMatch          <https://w3id.org/gso/1.0/rockmaterial/Rock> ,
                             <https://pid.geoscience.gov.au/def/voc/ga/materialtype/rock> ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/rock-core>
    a                        skos:Concept ;
    skos:prefLabel           "Rock Core"@en ;
    skos:definition          """A geological material, commonly cylindrical in shape, recovered from a borehole through drilling"""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/rock> ;
    skos:historyNote         "A rock core is the result of a specimen sampling technique, not a mutually exclusive geologic material category. Therefore, the term resides outside the scope  of the material category vocabulary"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:notation            "rockCore" ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/sample-return>
    a                        skos:Concept ;
    skos:prefLabel           "Sample Return"@en ;
    skos:definition          """Astromaterial returned from sample collection missions to celestial objects (e.g. comets, asteroids, the Moon, Mars)"""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/astromaterial> ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/superseded> ;
    skos:notation            "sampleReturn" ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/synthetic-mineral>
    a                        skos:Concept ;
    skos:prefLabel           "Synthetic Mineral"@en ;
    skos:definition          """Man-made materials created in a laboratory that are intended to representative of natural occurring geological material"""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/mineral> ;
    skos:historyNote         "Synthetic minerals are intended to represent natural-occurring minerals both physically and compositionally. The process that produced the material is not applicable to the geological specimen material category vocabulary and therefore was deprecated."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/deprecated> ;
    skos:notation            "syntheticMineral" ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/trace-fossil>
    a                        skos:Concept ;
    skos:prefLabel           "Trace Fossil"@en ;
    skos:altLabel            "Ichnofossil"@en ;
    skos:definition          """A sedimentary structure produced by the life activities (other than growth) of some organism"""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/fossil> ;
    dcterms:provenance       "Definition derived from Neuendorf KKE, Mehl JP, Jackson JA (eds) 2005. Glossary of geology. 5th Edition. Alexandria: American Geological Institute. Online Access."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "traceFossil" ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/unconsolidated-material>
    a                        skos:Concept ;
    skos:prefLabel           "Unconsolidated Material"@en ;
    skos:definition          """A geologic material composed of an aggregation of particles that do not adhere to each other strongly enough that the aggregate can be considered a solid in its own right."""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/geological-material> ;
    dcterms:provenance       "Term based on Rock Types defined by the Geoscience Ontology (https://w3id.org/gso/1.0/rockmaterial/ontology)"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "unconsolidatedMaterial" ;
    skos:exactMatch          <https://w3id.org/gso/1.0/rockmaterial/Unconsolidated_Material> ;
    skos:narrowMatch         <https://w3id.org/gso/1.0/rockmaterial/Natural_Unconsolidated_Material> ;
.

<https://kos.geospecimens.org/def/geological-specimen-material-category/interstellar-material>
    a                        skos:Concept ;
    skos:prefLabel           "Interstellar Material"@en ;
    skos:altLabel            "Cosmic dust"@en ,
                             "interplanetary dust particles"@en ;
    skos:definition          """Geological material captured from space and not genetically related to a large rocky body such as a planet or moon. Interstellar material occurs as particles ejected from stars, stellar remnants, or protoplanets. It is collected directly from space or the upper atmosphere rather than recovered as a discrete meteorite at Earth's surface."""@en ;
    skos:broader             <https://kos.geospecimens.org/def/geological-specimen-material-category/astromaterial> ;
    skos:historyNote         "Term superseded sample return"@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/geological-specimen-material-category> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:notation            "interstellarMaterial" ;
.


@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mc: <https://kos.geospecimens.org/def/meteorite-classification/> .
@prefix mclvl: <https://kos.geospecimens.org/def/meteorite-classification/level/> .
@prefix mcrank: <https://kos.geospecimens.org/def/meteorite-classification/rank/> .
@prefix mcref: <https://kos.geospecimens.org/def/meteorite-classification/reference/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uneskos: <http://purl.org/umu/uneskos#> .
@prefix xkos: <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

() a rdf:List .

mclvl:clan a xkos:ClassificationLevel ;
    xkos:depth "3"^^xsd:positiveInteger ;
    xkos:organizedBy mcrank:clan ;
    skos:member mc:acapulcoite-lodranite-clan,
        mc:ci-clan,
        mc:cm-co-clan,
        mc:cr-clan,
        mc:cv-ck-clan,
        mc:eh-el-clan,
        mc:h-l-ll-clan,
        mc:hed-clan-vesta,
        mc:irons,
        mc:lunar-moon,
        mc:martian-snc,
        mc:pallasites,
        mc:winonaite-iab-iiicd-clan ;
    skos:prefLabel "Clan level"@en .

mclvl:class a xkos:ClassificationLevel ;
    xkos:depth "2"^^xsd:positiveInteger ;
    xkos:organizedBy mcrank:class ;
    skos:member mc:carbonaceous-chondrites,
        mc:enstatite-chondrites,
        mc:ordinary-chondrites ;
    skos:prefLabel "Class level"@en .

mclvl:division a xkos:ClassificationLevel ;
    xkos:depth "1"^^xsd:positiveInteger ;
    xkos:organizedBy mcrank:division ;
    skos:member mc:achondrites,
        mc:chondrites,
        mc:primitive-achondrites ;
    skos:prefLabel "Division level"@en .

mclvl:group a xkos:ClassificationLevel ;
    xkos:depth "4"^^xsd:positiveInteger ;
    xkos:organizedBy mcrank:group ;
    skos:member mc:acapulcoite,
        mc:angrite,
        mc:aubrite,
        mc:brachinite,
        mc:cb-bencubbin-type,
        mc:ch-high-metal,
        mc:chassignite,
        mc:ci-ivuna-type,
        mc:ck-karoonda-type,
        mc:cm-mighei-type,
        mc:co-ornans-type,
        mc:cr-renazzo-type,
        mc:cv-vigarano-type,
        mc:diogenite,
        mc:eagle-station-pallasite,
        mc:eh-high-iron,
        mc:el-low-iron,
        mc:eucrite,
        mc:h-high-iron,
        mc:howardite,
        mc:iab-iron-silicate-bearing,
        mc:ic-iron-group,
        mc:iiab-iron-group,
        mc:iic-iron-group,
        mc:iid-iron-group,
        mc:iie-iron-group,
        mc:iiiab-iron-group,
        mc:iiicd-iron-silicate-bearing,
        mc:iiie-iron-group,
        mc:iiif-iron-group,
        mc:iva-iron-group,
        mc:ivb-iron-group,
        mc:k-kakangari-type,
        mc:l-low-iron,
        mc:ll-low-iron-low-metal,
        mc:lodranite,
        mc:main-group-pallasite,
        mc:mesosiderite,
        mc:nakhlite,
        mc:orthopyroxenite,
        mc:pyroxene-pallasite,
        mc:r-rumuruti-type,
        mc:shergottite,
        mc:ureilite,
        mc:winonaite ;
    skos:prefLabel "Group level"@en .

mclvl:subgroup a xkos:ClassificationLevel ;
    xkos:depth "5"^^xsd:positiveInteger ;
    xkos:organizedBy mcrank:subgroup ;
    skos:member mc:cb-subgroup-a,
        mc:cb-subgroup-b,
        mc:cv-subgroup-a-oxidized-allende-like,
        mc:cv-subgroup-b-oxidized-bali-like,
        mc:cv-subgroup-reduced ;
    skos:prefLabel "Subgroup level"@en .

mcref:lunarlit a dct:BibliographicResource ;
    rdfs:label "lunar meteorite literature (Korotev; Lunar Meteorite Compendium)"@en ;
    dct:bibliographicCitation "Korotev R. L. (2005) Lunar geochemistry as told by lunar meteorites. Chemie der Erde - Geochemistry, 65(4), 297-346; and Lunar Meteorite Compendium (Righter K., compiler), NASA Johnson Space Center."@en ;
    dct:identifier <https://curator.jsc.nasa.gov/antmet/lmc/> .

mcref:wassonkallemeyn2002 a dct:BibliographicResource ;
    rdfs:label "Wasson & Kallemeyn (2002)"@en ;
    dct:bibliographicCitation "Wasson J. T. and Kallemeyn G. W. (2002) The IAB iron-meteorite complex: A group, five subgroups, numerous grouplets, closely related, mainly formed by crystal segregation in rapidly cooling melts. Geochimica et Cosmochimica Acta, 66(13), 2445-2473."@en .

mc:acapulcoite a skos:Concept ;
    dct:identifier "acapulcoite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:acapulcoite-lodranite-clan ;
    skos:broader mc:acapulcoite-lodranite-clan ;
    skos:definition "Acapulcoites; fine-grained (150-230 um) equigranular rocks with near-chondritic mineral abundances and rare relict chondrules; formed by very low-degree partial melting (~950 C)."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "ACA" ;
    skos:prefLabel "Acapulcoite"@en .

<https://kos.geospecimens.org/def/meteorite-classification/agent/geospecimens> a foaf:Agent ;
    foaf:homepage <https://kos.geospecimens.org/> ;
    foaf:name "geospecimens.org"@en .

mc:angrite a skos:Concept ;
    dct:identifier "angrite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:achondrites ;
    skos:broader mc:achondrites ;
    skos:definition "Angrites; vesicular basaltic igneous rocks with unusual Ca-Al-Ti-rich pyroxene, Ca-rich olivine and anorthitic plagioclase - the most alkali-depleted basalts known; O-isotopes near HED but mineralogically distinct."@en ;
    skos:editorialNote "Connects directly to Achondrites"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "ANG" ;
    skos:prefLabel "Angrite"@en .

mc:aubrite a skos:Concept ;
    dct:identifier "aubrite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:achondrites ;
    skos:broader mc:achondrites ;
    skos:definition "Aubrites (enstatite achondrites); highly reduced, brecciated rocks of nearly FeO-free enstatite with E-chondrite-like sulfides; likely linked to, but from a different parent body than, the EL chondrites."@en ;
    skos:editorialNote "Connects directly to Achondrites"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "AUB" ;
    skos:prefLabel "Aubrite"@en .

mc:brachinite a skos:Concept ;
    dct:identifier "brachinite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:primitive-achondrites ;
    skos:broader mc:primitive-achondrites ;
    skos:definition "Brachinites; medium- to coarse-grained, olivine-rich (74-98%) equigranular achondrites with near-chondritic lithophile abundances; debated origin as residues, cumulates, or recrystallized chondritic material."@en ;
    skos:editorialNote "Connects directly to Primitive Achondrites (no clan box)"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "BRA" ;
    skos:prefLabel "Brachinite"@en .

mc:cb-subgroup-a a skos:Concept ;
    dct:identifier "cb-subgroup-a" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cb-bencubbin-type ;
    skos:broader mc:cb-bencubbin-type ;
    skos:definition "CBa; ~60 vol% metal, centimeter-sized chondrules, metal with 5-8 wt% Ni, d15N up to ~1000 per mil."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CB_a" ;
    skos:prefLabel "CB subgroup a"@en .

mc:cb-subgroup-b a skos:Concept ;
    dct:identifier "cb-subgroup-b" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cb-bencubbin-type ;
    skos:broader mc:cb-bencubbin-type ;
    skos:definition "CBb; >70 vol% metal, millimeter-sized chondrules, metal with 4-15 wt% Ni, d15N ~200 per mil; argued to be the more primitive nebular endmember."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CB_b" ;
    skos:prefLabel "CB subgroup b"@en .

mc:ch-high-metal a skos:Concept ;
    dct:identifier "ch-high-metal" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cr-clan ;
    skos:broader mc:cr-clan ;
    skos:definition "ALH 85085-type; high metal (~20 vol%), tiny (<100 um) mostly cryptocrystalline chondrules, virtually no matrix, very large d15N anomalies."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CH" ;
    skos:prefLabel "CH (high-metal)"@en .

mc:chassignite a skos:Concept ;
    dct:identifier "chassignite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:martian-snc ;
    skos:broader mc:martian-snc ;
    skos:definition "Chassignites; olivine-rich (dunitic) cumulate martian rocks (e.g., Chassigny)."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CHA" ;
    skos:prefLabel "Chassignite"@en .

mc:ci-ivuna-type a skos:Concept ;
    dct:identifier "ci-ivuna-type" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:ci-clan ;
    skos:broader mc:ci-clan ;
    skos:definition "Ivuna-type; among the most primitive solar-system materials, bulk composition close to the solar photosphere. All petrologic type 1: heavily hydrated, brecciated, chondrule- and CAI-free phyllosilicate-rich rocks."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CI" ;
    skos:prefLabel "CI (Ivuna-type)"@en .

mc:ck-karoonda-type a skos:Concept ;
    dct:identifier "ck-karoonda-type" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cv-ck-clan ;
    skos:broader mc:cv-ck-clan ;
    skos:definition "Karoonda-type; matrix-rich with large (700-1000 um) porphyritic chondrules; highly oxidized (fayalitic olivine, abundant magnetite), mostly high petrologic type 4-6."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CK" ;
    skos:prefLabel "CK (Karoonda-type)"@en .

mc:cm-mighei-type a skos:Concept ;
    dct:identifier "cm-mighei-type" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cm-co-clan ;
    skos:broader mc:cm-co-clan ;
    skos:definition "Mighei-type; the most abundant C chondrites. Small (~300 um) chondrules, abundant matrix, CAIs/AOAs partly replaced by phyllosilicates; mostly aqueously altered type 2 (some type 1)."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CM" ;
    skos:prefLabel "CM (Mighei-type)"@en .

mc:co-ornans-type a skos:Concept ;
    dct:identifier "co-ornans-type" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cm-co-clan ;
    skos:broader mc:cm-co-clan ;
    skos:definition "Ornans-type; small (~150 um) chondrules with 30-45 vol% matrix; petrologic types 3.0-3.7, O-isotopes on the CCAM line overlapping CV."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CO" ;
    skos:prefLabel "CO (Ornans-type)"@en .

mc:cr-renazzo-type a skos:Concept ;
    dct:identifier "cr-renazzo-type" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cr-clan ;
    skos:broader mc:cr-clan ;
    skos:definition "Renazzo-type; mostly type 2, with large metal-rich porphyritic Mg-rich chondrules with multilayered rims, hydrated matrix, solar-Ni/Co metal, and large d15N."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CR" ;
    skos:prefLabel "CR (Renazzo-type)"@en .

mc:cv-subgroup-a-oxidized-allende-like a skos:Concept ;
    dct:identifier "cv-subgroup-a-oxidized-allende-like" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cv-vigarano-type ;
    skos:broader mc:cv-vigarano-type ;
    skos:definition "Oxidized Allende-like CV (CVoxA); secondary ferrous olivine, Ca,Fe-pyroxene, andradite and nepheline/sodalite, coarser matrix than CVoxB with only minor phyllosilicates."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CV_A" ;
    skos:prefLabel "CV subgroup A (oxidized, Allende-like)"@en .

mc:cv-subgroup-b-oxidized-bali-like a skos:Concept ;
    dct:identifier "cv-subgroup-b-oxidized-bali-like" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cv-vigarano-type ;
    skos:broader mc:cv-vigarano-type ;
    skos:definition "Oxidized Bali-like CV (CVoxB); aqueously altered with abundant phyllosilicates, magnetite, fayalite and Ca,Fe-pyroxenes; highest matrix/chondrule ratio."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CV_B" ;
    skos:prefLabel "CV subgroup B (oxidized, Bali-like)"@en .

mc:cv-subgroup-reduced a skos:Concept ;
    dct:identifier "cv-subgroup-reduced" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:cv-vigarano-type ;
    skos:broader mc:cv-vigarano-type ;
    skos:definition "Reduced CV (CVred); lowest matrix/chondrule and highest metal/magnetite ratios, with only minor nepheline/sodalite and Ca,Fe-pyroxenes."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "CV_red" ;
    skos:prefLabel "CV subgroup (reduced)"@en .

mc:diogenite a skos:Concept ;
    dct:identifier "diogenite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:hed-clan-vesta ;
    skos:broader mc:hed-clan-vesta ;
    skos:definition "Diogenites; coarse orthopyroxene cumulates from deeper plutonic levels of the HED parent body."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "DIO" ;
    skos:prefLabel "Diogenite"@en .

mc:eagle-station-pallasite a skos:Concept ;
    dct:identifier "eagle-station-pallasite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:pallasites ;
    skos:broader mc:pallasites ;
    skos:definition "Eagle Station grouplet; more ferroan, Ca-rich olivine and distinct O-isotopes; metal resembles IIF irons (higher Ni and Ir)."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "ES PAL" ;
    skos:prefLabel "Eagle Station pallasite"@en .

mc:eh-high-iron a skos:Concept ;
    dct:identifier "eh-high-iron" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:eh-el-clan ;
    skos:broader mc:eh-el-clan ;
    skos:definition "High-Fe enstatite chondrites; more reduced, niningerite-bearing, with Si-rich (2-3 wt%) metal."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "EH" ;
    skos:prefLabel "EH (high iron)"@en .

mc:el-low-iron a skos:Concept ;
    dct:identifier "el-low-iron" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:eh-el-clan ;
    skos:broader mc:eh-el-clan ;
    skos:definition "Low-Fe enstatite chondrites; alabandite-bearing, <1 wt% Si in metal, ranging to higher petrologic types (EL6)."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "EL" ;
    skos:prefLabel "EL (low iron)"@en .

mc:eucrite a skos:Concept ;
    dct:identifier "eucrite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:hed-clan-vesta ;
    skos:broader mc:hed-clan-vesta ;
    skos:definition "Eucrites; basalts of plagioclase and clinopyroxene (pyroxene Fe/Mn ~30) from near-surface flows or intrusives; commonly brecciated."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "EUC" ;
    skos:prefLabel "Eucrite"@en .

mc:h-high-iron a skos:Concept ;
    dct:identifier "h-high-iron" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:h-l-ll-clan ;
    skos:broader mc:h-l-ll-clan ;
    skos:definition "Highest total Fe and metallic-Fe/FeO ratio among O chondrites; equilibrated olivine Fa16-20."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "H" ;
    skos:prefLabel "H (high iron)"@en .

mc:howardite a skos:Concept ;
    dct:identifier "howardite" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:hed-clan-vesta ;
    skos:broader mc:hed-clan-vesta ;
    skos:definition "Howardites; polymict regolith breccias mixing eucritic and diogenitic clasts."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "HOW" ;
    skos:prefLabel "Howardite"@en .

mc:iab-iron-silicate-bearing a skos:Concept ;
    dct:identifier "iab-iron-silicate-bearing" ;
    dct:source mcref:wassonkallemeyn2002,
        mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:specializes mc:winonaite-iab-iiicd-clan ;
    skos:broader mc:winonaite-iab-iiicd-clan ;
    skos:definition "Silicate-bearing iron group whose inclusions resemble winonaites in mineralogy and O-isotopes; historically called 'nonmagmatic,' with textures suggesting impact mixing of metal and silicate. Wasson & Kallemeyn (2002) merge IAB+IIICD as the 'IAB complex.'"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:notation "IAB" ;
    skos:prefLabel "IAB iron (silicate-bearing)"@en .

mc:ic-iron-group a skos:Concept ;

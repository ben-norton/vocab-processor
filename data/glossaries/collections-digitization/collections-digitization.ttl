    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/biology>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Biology"@en ;
    skos:definition          """Biology is the science of life. It is concerned with the characteristics and behaviors of organisms"""@en ;
    skos:notation            "biology" ;
    dcterms:identifier       "biology" ;
    dcterms:source           "Modern Science Ontology" ;

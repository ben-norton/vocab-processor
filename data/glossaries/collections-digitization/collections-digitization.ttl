    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/collection-management>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Collection Management"@en ;
    skos:definition          """All practices and procedures implemented by a museum in acquiring, documenting, handling, accessing, cataloguing, storing, securing, lending, conserving and disposing of collection objects"""@en ;
    skos:notation            "collection-management" ;
    dcterms:identifier       "collection-management" ;
    dcterms:source           "ISO 18461:2016 International museum statistics" ;

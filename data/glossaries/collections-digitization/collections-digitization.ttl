<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-cleaning>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Cleaning"@en ;
    skos:definition          """Refers to the step or series of steps for cleaning and curating data in a workflow."""@en ;
    skos:scopeNote           "Typically these steps are undertaken by sophisticated tooling/services, or by human interactions. A Data Cleaning step preserves and enriches the content of data."@en ;
    skos:notation            "data-cleaning" ;
    dcterms:identifier       "data-cleaning" ;

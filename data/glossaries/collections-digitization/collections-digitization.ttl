    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/contributor>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Contributor"@en ;
    skos:definition          """An entity responsible for making contributions to the resource."""@en ;
    skos:notation            "contributor" ;
    dcterms:identifier       "contributor" ;
    dcterms:source           "DCMI Metadata Terms" ;
    rdfs:seeAlso             <http://purl.org/dc/terms/contributor> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;

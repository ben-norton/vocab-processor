@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mc: <https://kos.geospecimens.org/meteorite/> .
@prefix mccls: <https://kos.geospecimens.org/meteorite/class/> .
@prefix mcit: <https://kos.geospecimens.org/meteorite/itemtype/> .
@prefix mclvl: <https://kos.geospecimens.org/meteorite/level/> .
@prefix mcnote: <https://kos.geospecimens.org/meteorite/note/> .
@prefix mcref: <https://kos.geospecimens.org/meteorite/reference/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xkos: <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mccls:ClanItem a owl:Class ;
    rdfs:seeAlso mclvl:clan ;
    rdfs:subClassOf mccls:MeteoriteItem ;
    skos:prefLabel "Clan"@en .

mccls:ClassItem a owl:Class ;
    rdfs:seeAlso mclvl:class ;
    rdfs:subClassOf mccls:MeteoriteItem ;
    skos:prefLabel "Class"@en .

mccls:DivisionItem a owl:Class ;
    rdfs:seeAlso mclvl:division ;
    rdfs:subClassOf mccls:MeteoriteItem ;
    skos:prefLabel "Division"@en .

mccls:GroupItem a owl:Class ;
    rdfs:seeAlso mclvl:group ;
    rdfs:subClassOf mccls:MeteoriteItem ;
    skos:prefLabel "Group"@en .

mccls:SubgroupItem a owl:Class ;
    rdfs:seeAlso mclvl:subgroup ;
    rdfs:subClassOf mccls:MeteoriteItem ;
    skos:prefLabel "Subgroup"@en .

mc:classification a skos:Concept ;
    rdfs:comment "Version-independent concept identifying the meteorite classification, used as the entry point under which dated major versions are grouped via xkos:belongsTo."@en ;
    skos:prefLabel "Meteorite classification"@en .

mcnote:MC_0001 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Solid extraterrestrial fragments that survive atmospheric passage; classified by mineralogy, petrography, bulk chemistry and O-isotopes into chondrites, primitive achondrites and achondrites."@en .

mcnote:MC_0002 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Undifferentiated meteorites with broadly solar (CI-like) bulk compositions minus the most volatile elements, from bodies that never underwent planetary melting; most contain chondrules. 15 groups across the C, O and E classes plus R and K."@en .

mcnote:MC_0003 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Nonchondritic meteorites with igneous or recrystallized textures that retain a chemical/isotopic affinity to chondritic precursors; interpreted as residues or low-degree partial melts that did not fully differentiate."@en .

mcnote:MC_0004 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Differentiated meteorites - igneous rocks, melt residues, or breccias of igneous fragments - from asteroids, Mars and the Moon that experienced a high degree of melting; includes stones, stony-irons and irons."@en .

mcnote:MC_0005 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Chondrite class with Mg-normalized refractory-lithophile abundances at or above CI and O-isotopes plotting near or below the terrestrial fractionation line; eight groups."@en .

mcnote:MC_0006 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "The most abundant chondrites (>85% of falls); abundant large chondrules, low matrix, refractory-lithophile abundances below CI, O-isotopes above the TF line. The three groups form one clan."@en .

mcnote:MC_0007 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Chondrites formed under highly reducing conditions, with Fe-poor silicates, Si-bearing metal and unusual sulfides/nitrides; O-isotopes on the TF line near Earth and the Moon. Two groups."@en .

mcnote:MC_0008 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Single-group clan; CI chondrites show nothing linking them to the other carbonaceous clans."@en .

mcnote:MC_0009 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Clan linking the CM and CO groups by similar chondrule sizes, refractory-lithophile abundances, and high-temperature-mineral O-isotopes."@en .

mcnote:MC_0010 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Clan grouping CV and CK chondrites, which share overlapping CCAM-line O-isotopes and magnetite chemistry; low-type CK resembles oxidized CV."@en .

mcnote:MC_0011 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Clan of the metal-rich CR, CH and CB groups (plus ungrouped LEW 85332), united by solar-Ni/Co metal, strong volatile-lithophile depletions, CR-line O-isotopes, and large d15N anomalies."@en .

mcnote:MC_0012 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Ivuna-type; among the most primitive solar-system materials, bulk composition close to the solar photosphere. All petrologic type 1: heavily hydrated, brecciated, chondrule- and CAI-free phyllosilicate-rich rocks."@en .

mcnote:MC_0013 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Mighei-type; the most abundant C chondrites. Small (~300 um) chondrules, abundant matrix, CAIs/AOAs partly replaced by phyllosilicates; mostly aqueously altered type 2 (some type 1)."@en .

mcnote:MC_0014 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Ornans-type; small (~150 um) chondrules with 30-45 vol% matrix; petrologic types 3.0-3.7, O-isotopes on the CCAM line overlapping CV."@en .

mcnote:MC_0015 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Vigarano-type; abundant matrix, large (~1 mm) chondrules and abundant large CAIs/AOAs; all type 3, divided into oxidized and reduced subgroups."@en .

mcnote:MC_0016 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Karoonda-type; matrix-rich with large (700-1000 um) porphyritic chondrules; highly oxidized (fayalitic olivine, abundant magnetite), mostly high petrologic type 4-6."@en .

mcnote:MC_0017 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Renazzo-type; mostly type 2, with large metal-rich porphyritic Mg-rich chondrules with multilayered rims, hydrated matrix, solar-Ni/Co metal, and large d15N."@en .

mcnote:MC_0018 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "ALH 85085-type; high metal (~20 vol%), tiny (<100 um) mostly cryptocrystalline chondrules, virtually no matrix, very large d15N anomalies."@en .

mcnote:MC_0019 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Bencubbin-type; extreme metal (60-80 vol%), cryptocrystalline/barred chondrules, strong volatile-lithophile depletion and heavy-N enrichment; subgroups CBa and CBb."@en .

mcnote:MC_0020 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Oxidized Allende-like CV (CVoxA); secondary ferrous olivine, Ca,Fe-pyroxene, andradite and nepheline/sodalite, coarser matrix than CVoxB with only minor phyllosilicates."@en .

mcnote:MC_0021 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Oxidized Bali-like CV (CVoxB); aqueously altered with abundant phyllosilicates, magnetite, fayalite and Ca,Fe-pyroxenes; highest matrix/chondrule ratio."@en .

mcnote:MC_0022 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Reduced CV (CVred); lowest matrix/chondrule and highest metal/magnetite ratios, with only minor nepheline/sodalite and Ca,Fe-pyroxenes."@en .

mcnote:MC_0023 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "CBa; ~60 vol% metal, centimeter-sized chondrules, metal with 5-8 wt% Ni, d15N up to ~1000 per mil."@en .

mcnote:MC_0024 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "CBb; >70 vol% metal, millimeter-sized chondrules, metal with 4-15 wt% Ni, d15N ~200 per mil; argued to be the more primitive nebular endmember."@en .

mcnote:MC_0025 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Single ordinary-chondrite clan; H, L and LL overlap in O-isotopes and petrology, indicating close kinship."@en .

mcnote:MC_0026 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Highest total Fe and metallic-Fe/FeO ratio among O chondrites; equilibrated olivine Fa16-20."@en .

mcnote:MC_0027 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Intermediate Fe content among O chondrites; equilibrated olivine Fa23-26."@en .

mcnote:MC_0028 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Lowest Fe and metal among O chondrites; equilibrated olivine Fa27-32."@en .

mcnote:MC_0029 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Single enstatite-chondrite clan; EH and EL are distinguished mainly by sulfide chemistry and metal Si content."@en .

mcnote:MC_0030 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "High-Fe enstatite chondrites; more reduced, niningerite-bearing, with Si-rich (2-3 wt%) metal."@en .

mcnote:MC_0031 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Low-Fe enstatite chondrites; alabandite-bearing, <1 wt% Si in metal, ranging to higher petrologic types (EL6)."@en .

mcnote:MC_0032 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Rumuruti-type; highly oxidized, FeO-rich olivine (Fa37-40), nearly metal-free, ~50% matrix; highest delta-17O of any chondrite group; affiliated with but distinct from the O class (possibly a separate class or O clan)."@en .

mcnote:MC_0033 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Kakangari-type grouplet; chemically, mineralogically and isotopically distinct from the C, O and E classes; high matrix, Fe-poor olivine/enstatite, O-isotopes below the TF line; a candidate first member of a fourth chondrite class."@en .

mcnote:MC_0034 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Ureilites; olivine-pyroxene rocks with interstitial graphite/diamond, metal and sulfides and reduced olivine rims; O-isotopes scatter along the CCAM line. Interpreted as partial-melt residues / mantle rock of the ureilite parent body."@en .

mcnote:MC_0035 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Brachinites; medium- to coarse-grained, olivine-rich (74-98%) equigranular achondrites with near-chondritic lithophile abundances; debated origin as residues, cumulates, or recrystallized chondritic material."@en .

mcnote:MC_0036 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Acapulcoite-Lodranite clan; primitive achondrites with similar, spread O-isotopes; residues/products of low-degree partial melting of a chondritic precursor."@en .

mcnote:MC_0037 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Acapulcoites; fine-grained (150-230 um) equigranular rocks with near-chondritic mineral abundances and rare relict chondrules; formed by very low-degree partial melting (~950 C)."@en .

mcnote:MC_0038 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Lodranites; coarse-grained (540-700 um) olivine-pyroxene rocks depleted in plagioclase and troilite; residues of higher-degree partial melting (~1250 C) with basaltic-melt removal."@en .

mcnote:MC_0039 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Winonaite-IAB-IIICD clan; silicate mineralogy and O-isotopes link winonaites to silicate inclusions in IAB (and possibly IIICD) irons, implying a shared or similar parent body."@en .

mcnote:MC_0040 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Winonaites; chondritic mineralogy/composition but recrystallized achondritic textures; mineral compositions between E and H chondrites, with Fe,Ni-FeS veins recording first partial melts."@en .

mcnote:MC_0041 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Silicate-bearing iron group whose inclusions resemble winonaites in mineralogy and O-isotopes; historically called 'nonmagmatic,' with textures suggesting impact mixing of metal and silicate. Wasson & Kallemeyn (2002) merge IAB+IIICD as the 'IAB complex.'"@en .

mcnote:MC_0042 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Silicate-bearing iron group historically paired with IAB; Wasson & Kallemeyn (2002) treat IAB+IIICD as a single IAB complex. Geochemical trends differ from the magmatic groups."@en .

mcnote:MC_0043 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Angrites; vesicular basaltic igneous rocks with unusual Ca-Al-Ti-rich pyroxene, Ca-rich olivine and anorthitic plagioclase - the most alkali-depleted basalts known; O-isotopes near HED but mineralogically distinct."@en .

mcnote:MC_0044 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Aubrites (enstatite achondrites); highly reduced, brecciated rocks of nearly FeO-free enstatite with E-chondrite-like sulfides; likely linked to, but from a different parent body than, the EL chondrites."@en .

mcnote:MC_0045 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Mesosiderites; stony-iron breccias of roughly equal silicate (basalt/gabbro/pyroxenite clasts) and Fe,Ni-metal+troilite, with metal intimately mixed with similarly sized silicate grains."@en .

mcnote:MC_0046 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "HED clan (howardites-eucrites-diogenites); basalts and orthopyroxene cumulates from a common asteroidal parent, sharing O-isotopes and pyroxene Fe/Mn; spectrally linked to asteroid 4 Vesta."@en .

mcnote:MC_0047 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Eucrites; basalts of plagioclase and clinopyroxene (pyroxene Fe/Mn ~30) from near-surface flows or intrusives; commonly brecciated."@en .

mcnote:MC_0048 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Diogenites; coarse orthopyroxene cumulates from deeper plutonic levels of the HED parent body."@en .

mcnote:MC_0049 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Howardites; polymict regolith breccias mixing eucritic and diogenitic clasts."@en .

mcnote:MC_0050 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Pallasites; olivine-metal (+troilite) stony-irons. 'Pallasite' is essentially a textural term: the main-group, Eagle Station and pyroxene pallasites (plus ungrouped Milton) formed on separate parent bodies and do not form a true clan/group."@en .

mcnote:MC_0051 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Main-group pallasites; olivine-metal rocks whose metal resembles Ni-rich IIIAB irons and whose O-isotopes match the HEDs (no proven genetic link)."@en .

mcnote:MC_0052 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Eagle Station grouplet; more ferroan, Ca-rich olivine and distinct O-isotopes; metal resembles IIF irons (higher Ni and Ir)."@en .

mcnote:MC_0053 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Pyroxene-pallasite grouplet (e.g., Vermillion, Y-8451); contain mm-sized pyroxene, with metal and O-isotopes distinguishing them from the other pallasites."@en .

mcnote:MC_0054 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Iron meteorites; mostly cores of differentiated asteroids. The chemical classification (Scott & Wasson) uses Ga, Ge, Ir and Ni - a Roman numeral plus a letter - resolving 13 groups; ~10 are consistent with fractional crystallization in separate cores, and ~15% of irons (40% in Antarctica) are ungrouped."@en .

mcnote:MC_0055 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Magmatic iron group resolved on Ga/Ge-Ni plots; interpreted as a fractionally crystallized asteroid core."@en .

mcnote:MC_0056 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Largest magmatic iron group (hexahedrites/coarse octahedrites); a fractional-crystallization trend from a single core."@en .

mcnote:MC_0057 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Magmatic iron group with a traditional core-crystallization history."@en .

mcnote:MC_0058 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Magmatic iron group formed by fractional crystallization in an asteroid core."@en .

mcnote:MC_0059 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Silicate-bearing iron group; some silicates resemble H chondrites. Historically 'nonmagmatic,' with poorly defined elemental trends suggesting impact mixing of metal and silicate."@en .

mcnote:MC_0060 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "One of the largest magmatic iron groups (octahedrites); a single fractional-crystallization sequence (former IIIA+IIIB), with metal close to main-group-pallasite composition."@en .

mcnote:MC_0061 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Magmatic iron group resembling IIIA/IIIAB but resolved by lower Ga/Ni and Ge/Ni, larger kamacite bandwidths, and haxonite (carbide) in its members."@en .

mcnote:MC_0062 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Small, volatile-depleted (low Ga/Ge) magmatic iron group, distinct from IIIAB."@en .

mcnote:MC_0063 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Volatile-depleted magmatic iron group (fine octahedrites) with a range of cooling rates, suggesting metal pods at varying depths in a partially molten body."@en .

mcnote:MC_0064 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Most volatile-depleted iron group; metal matches a high-temperature (~1270 K) nebular condensate, implying high-temperature accretion."@en .

mcnote:MC_0065 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Lunar meteorites; rocks launched from the Moon, sharing mineralogy/Fe-Mn and O-isotopes with Apollo/Luna samples but sampling random sites (including the farside). Mainly feldspathic-highland breccias, mare basalts/breccias, and mingled breccias."@en .

mcnote:MC_0066 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Martian (SNC) meteorites; crustal igneous rocks from Mars defining a unique slope-0.52 O-isotope line, with trapped gases matching the martian atmosphere. Includes shergottites, nakhlites, chassignites and orthopyroxenite ALH 84001."@en .

mcnote:MC_0067 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Shergottites; basaltic and lherzolitic/olivine-phyric volcanic-plutonic rocks, mostly young (<1.3 Ga); the most abundant martian meteorites."@en .

mcnote:MC_0068 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Nakhlites; clinopyroxene (augite)-rich cumulate rocks from Mars."@en .

mcnote:MC_0069 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Chassignites; olivine-rich (dunitic) cumulate martian rocks (e.g., Chassigny)."@en .

mcnote:MC_0070 a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Orthopyroxenite represented by ALH 84001, a ~4.5 Ga coarse orthopyroxene cumulate from Mars, originally misclassified as a diogenite."@en .

mcnote:scheme a xkos:ExplanatoryNote ;
    dcterms:language "en"^^xsd:language ;
    xkos:plainText "Classification framework of Weisberg, McCoy & Krot (2006). Meteorites are divided into three divisions (chondrites = undifferentiated; primitive achondrites; achondrites = differentiated) and further organised into classes, clans, groups and subgroups. Because clans and groups may attach at different depths of the tree, the rank system is modelled as XKOS classification levels that are decoupled from the broader/narrower hierarchy."@en .

mcref:lunarlit a dcterms:BibliographicResource ;
    rdfs:label "lunar meteorite literature (Korotev; Lunar Meteorite Compendium)"@en ;
    dc:identifier "https://curator.jsc.nasa.gov/antmet/lmc/" ;
    dcterms:bibliographicCitation "Korotev R. L. (2005) Lunar geochemistry as told by lunar meteorites. Chemie der Erde - Geochemistry, 65(4), 297-346; and Lunar Meteorite Compendium (Righter K., compiler), NASA Johnson Space Center."@en .

mcit:subgroup a skos:Concept ;
    skos:broader mcit:group ;
    skos:inScheme mc:itemTypes ;
    skos:prefLabel "Subgroup"@en .

mclvl:clan a xkos:ClassificationLevel ;
    xkos:depth 3 ;
    xkos:organizedBy mcit:clan ;
    rdfs:seeAlso mccls:ClanItem ;
    skos:member mc:MC_0008,
        mc:MC_0009,
        mc:MC_0010,
        mc:MC_0011,
        mc:MC_0025,
        mc:MC_0029,
        mc:MC_0036,
        mc:MC_0039,
        mc:MC_0046,
        mc:MC_0050,
        mc:MC_0054,
        mc:MC_0065,
        mc:MC_0066 ;
    skos:prefLabel "Clan level"@en .

mclvl:class a xkos:ClassificationLevel ;
    xkos:depth 2 ;
    xkos:organizedBy mcit:class ;
    rdfs:seeAlso mccls:ClassItem ;
    skos:member mc:MC_0005,
        mc:MC_0006,
        mc:MC_0007 ;
    skos:prefLabel "Class level"@en .

mclvl:division a xkos:ClassificationLevel ;
    xkos:depth 1 ;
    xkos:organizedBy mcit:division ;
    rdfs:seeAlso mccls:DivisionItem ;
    skos:member mc:MC_0002,
        mc:MC_0003,
        mc:MC_0004 ;
    skos:prefLabel "Division level"@en .

mclvl:group a xkos:ClassificationLevel ;
    xkos:depth 4 ;
    xkos:organizedBy mcit:group ;
    rdfs:seeAlso mccls:GroupItem ;
    skos:member mc:MC_0012,
        mc:MC_0013,
        mc:MC_0014,
        mc:MC_0015,
        mc:MC_0016,
        mc:MC_0017,
        mc:MC_0018,
        mc:MC_0019,
        mc:MC_0026,
        mc:MC_0027,
        mc:MC_0028,
        mc:MC_0030,
        mc:MC_0031,
        mc:MC_0032,
        mc:MC_0033,
        mc:MC_0034,
        mc:MC_0035,
        mc:MC_0037,
        mc:MC_0038,
        mc:MC_0040,
        mc:MC_0041,
        mc:MC_0042,
        mc:MC_0043,
        mc:MC_0044,

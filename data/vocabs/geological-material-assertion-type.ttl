<https://kos.geospecimens.org/def/geological-material-assertion-type>
    a                        skos:ConceptScheme ;
    dcterms:title            "Geological Material Assertion Types"@en ;
    dcterms:description      """The Geological Material Assertion Types vocabulary provides a standardized set of assertion types for describing the observable, measurable, and structural qualities of geological materials, with particular emphasis on mineral specimens held in earth science collections. It currently contains 17 concepts covering specimen dimensions (verbatim size, measured width, height, and depth in millimeters, maximum axial dimension), crystallographic and morphological characteristics (aggregate form, crystal habit, crystal form, twinning law, cleavage, exsolution texture), optical and surface properties (color, luster, luminescence description), and compositional or associational features (associated minerals, inclusions, alteration description). Each concept is expressed as an rdf:Property with a definition, usage guidance, and examples. The vocabulary was developed by the TDWG Mineralogy Extension Task Group and is intended for use in conjunction with the Darwin Core Data Package (DwC-DP, https://dwc.tdwg.org/dp/), where its terms supply values for the assertionType field of the MaterialAssertion table. In Darwin Core Archives, the same terms may be used in MeasurementOrFact or as keys in dynamicProperties."""@en ;
    dcterms:publisher        <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:creator          <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:contributor      "TDWG Mineralogy Extension Task Group"@en ;
    dcterms:provenance       "Compiled by the TDWG Mineralogy Extension Task Group for community use and to support the extension release by providing standardized categories for Constituent Part Names, especially those associated with Minerals"@en ;
    dcterms:created          "2026-09-11"^^xsd:date ;
    dcterms:modified         "2026-09-11"^^xsd:date ;
    dcat:version             "2026-09-11" ;
    skos:scopeNote           "Terms are targeted to described observable, measureable, and structural qualities of minerals belonging to collections in the earth sciences domain"@en ;
    vann:usageNote           "The terms in this vocabulary can be leveraged by any material as defined by Darwin Core, but designed specifically to meet the needs of the Mineralogical Collections Community"@en ;
    skos:historyNote         "This vocabulary was created following the results of a public review of the Mineralogy Extension terms during the 08/2026 Darwin Core Public Review"@en ;
    skos:note                "These terms were developed as part of the Mineralogy Extension to Darwin Core. Darwin Core DP introduces a new class, Material Assertions, which provides a mechanism for making assertions about specimens using externally maintained vocabularies. Because the terms in this vocabulary fit that pattern, it became the first Material Assertion vocabulary intended for use with Darwin Core. In Darwin Core Archives, these terms can be used in MeasurementOrFact or as keys in dynamicProperties."@en ;
    dcat:keyword             "Mineralogy Extension"@en ,
                             "Mineralogy"@en ,
                             "Geological Collections"@en ,
                             "Darwin Core"@en ,
                             "Material Assertion"@en ,
                             "Darwin Core Data Package"@en ;
    schema:citation          "Norton B, Walcott R, Burri T, Puschnig A, Dombrowski A, Greber N, Hints O, Mansur A, Ralph J, Richard S, Tacker C, Wieczorek J Geological Material Assertions Vocabulary (pending)."@en ;
    schema:license           <https://creativecommons.org/licenses/by/4.0/> ;
    reg:derivationMode       <https://linked.data.gov.au/def/vocdermods/none> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:hasTopConcept       <https://kos.geospecimens.org/def/geological-material-assertion-type/verbatim-size> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/measured-width-in-millimeters> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/measured-height-in-millimeters> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/measured-depth-in-millimeters> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/maximum-axial-dimension> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/associated-minerals> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/aggregate-form> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/crystal-habit> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/crystal-form> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/twinning-law> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/color> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/exsolution-texture> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/cleavage> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/luster> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/inclusions> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/luminescence-description> ,
                             <https://kos.geospecimens.org/def/geological-material-assertion-type/alteration-description> ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://kos.geospecimens.org/org/ben-norton> ;
        dcat:hadRole     isoroles:publisher , isoroles:author ;
    ] ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://kos.geospecimens.org/org/minext> ;
        dcat:hadRole     isoroles:editor , isoroles:custodian ;
    ] ;
.


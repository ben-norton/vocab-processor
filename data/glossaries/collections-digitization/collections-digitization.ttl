    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/crystallography>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Crystallography"@en ;
    skos:definition          """Crystallography is the scientific study of crystals."""@en ;
    skos:scopeNote           "Subclass of Chemistry"@en ;
    skos:notation            "crystallography" ;
    dcterms:identifier       "crystallography" ;

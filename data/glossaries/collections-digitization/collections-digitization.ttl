    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-integration>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Data Integration"@en ;
    skos:definition          """Systematic combining of data from different independent and potentially heterogeneous sources, to create a more compatible, unified view of these data for research purposes"""@en ;
    skos:notation            "data-integration" ;
    dcterms:identifier       "data-integration" ;
    dcterms:source           "ISO 5127:2017(en) Information and documentation — Foundation and vocabulary" ;
    rdfs:seeAlso             <https://www.iso.org/standard/59743.html> ;

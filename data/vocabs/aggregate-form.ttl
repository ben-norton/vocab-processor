<https://kos.resources.org/def/aggregate-form/acicular>
    a                        skos:Concept ;
    skos:prefLabel           "Acicular"@en ;
    skos:prefLabel           "stenglig"@de ;
    skos:definition          """Long prismatic needle-like form"""@en ;
    skos:inScheme            <https://kos.resources.org/def/aggregate-form> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.resources.org/def/aggregate-form> ;
    skos:notation            "acicular" ;
.

<https://kos.resources.org/def/aggregate-form/acicular-parallel>
    a                        skos:Concept ;
    skos:prefLabel           "Acicular Parallel"@en ;
    skos:prefLabel           "parallelstenglig"@de ;
    skos:definition          """Parallel orientation of acicular grains"""@en ;
    skos:broader             <https://kos.resources.org/def/aggregate-form/acicular> ;
    skos:inScheme            <https://kos.resources.org/def/aggregate-form> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:notation            "acicularParallel" ;
    skos:broadMatch          <https://kos.resources.org/def/aggregate-form/acicular> ;
.


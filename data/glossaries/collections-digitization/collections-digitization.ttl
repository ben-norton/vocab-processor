    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/collection-object>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Collection Object"@en ;
    skos:definition          """A physical or digital object that belongs to a museum collection"""@en ;
    skos:notation            "collection-object" ;
    dcterms:identifier       "collection-object" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;

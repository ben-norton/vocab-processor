    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/cultural-studies>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Cultural Studies"@en ;
    skos:definition          """Cultural studies is a field of theoretically, politically, and empirically engaged cultural analysis that concentrates upon the political dynamics of contemporary culture, its historical foundations, defining traits, conflicts, and contingencies."""@en ;
    skos:notation            "cultural-studies" ;
    dcterms:identifier       "cultural-studies" ;
    dcterms:source           "Modern Science Ontology" ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-entry>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Entry"@en ;
    skos:definition          """The process by which original, source data is inputted by a human into a digital, structured format for later use and analysis."""@en ;
    skos:notation            "data-entry" ;
    dcterms:identifier       "data-entry" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/NCIT_C142379> ;

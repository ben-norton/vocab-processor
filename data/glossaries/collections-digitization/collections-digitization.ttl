    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-curation-workflow>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Curation Workflow"@en ;
    skos:definition          """A type of workflow that includes active steps to curate data as an aid to ongoing management of data through its lifecycle."""@en ;

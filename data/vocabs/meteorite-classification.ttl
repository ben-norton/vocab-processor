    skos:notation "IVA" ;
    skos:prefLabel "IVA iron group"@en .

mc:ivb-iron-group a skos:Concept ;
    dct:identifier "ivb-iron-group" ;
    dct:source mcref:scottwasson1975,
        mcref:wassonironseries ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;

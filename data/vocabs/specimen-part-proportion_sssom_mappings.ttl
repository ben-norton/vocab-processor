@prefix sssom:   <https://w3id.org/sssom/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

[]
    a                         sssom:MappingSet ;
    sssom:mapping_set_id      "https://kos.geospecimens.org/def/specimen-part-proportion/mappings/sssom"^^xsd:anyURI ;
    sssom:mapping_set_title   "Specimen Part Proportion SSSOM Mappings" ;
    sssom:license             "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;

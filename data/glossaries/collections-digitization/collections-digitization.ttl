    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/anthropology>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Anthropology"@en ;
    skos:definition          """Anthropology is the scientific study of humans, human behavior and societies in the past and present."""@en ;

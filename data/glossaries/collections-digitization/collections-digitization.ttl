    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/curated-holding>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Curated Holding"@en ;
    skos:definition          """Comprises aggregations of physical objects that are curated and preserved by one or more Agents over time for a specific purpose and audience, and according to a particular collection development plan."""@en ;
    skos:notation            "curated-holding" ;
    dcterms:identifier       "curated-holding" ;
    dcterms:source           "Definition of the CIDOC Conceptual Reference Model version 7.1.3" ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-migration>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Migration"@en ;
    skos:definition          """The process of transporting data between computers, storage devices, or formats."""@en ;
    skos:scopeNote           "Data migration is a key consideration for any system implementation, upgrade or consolidation. During data migration, software programs or scripts are used to map system data for automated migration."@en ;
    skos:notation            "data-migration" ;
    dcterms:identifier       "data-migration" ;
    dcterms:source           "Master Glossary for DOI Museum Property Directives" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-mobility>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Mobility"@en ;
    skos:definition          """The ability of information to be accessed and exchanged between systems"""@en ;
    skos:notation            "data-mobility" ;
    dcterms:identifier       "data-mobility" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;

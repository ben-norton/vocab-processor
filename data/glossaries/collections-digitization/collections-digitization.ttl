.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/project-phase>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Project Phase"@en ;
    skos:definition          """A collection of logically-related project activities, usually culminating in the completion of an intended goal or deliverable"""@en ;
    skos:notation            "project-phase" ;
    dcterms:identifier       "project-phase" ;
    dcterms:source           "Project Management Glossary of Terms" ;

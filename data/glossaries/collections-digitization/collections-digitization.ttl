.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-curation-and-archival>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Archiving"@en ;
    skos:definition          """An activity that includes the preservation of data in a repository, archive, or a deposition database; and curation of data and metadata, database accessions, annotation, and data provenance with the goal of ensuring that data is findable and reusable."""@en ;
    skos:notation            "data-curation-and-archival" ;
    dcterms:identifier       "data-curation-and-archival" ;

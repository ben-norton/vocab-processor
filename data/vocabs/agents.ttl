@prefix agrelon:  <https://d-nb.info/standards/elementset/agrelon#> .
@prefix cmns-av:  <https://www.omg.org/spec/Commons/AnnotationVocabulary/> .
@prefix isoroles: <http://def.isotc211.org/iso19115-1/2014/CitationAndResponsiblePartyInformation/code/CI_RoleCode/> .
@prefix org:      <http://www.w3.org/ns/org#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:   <https://schema.org/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# Agents
# ============================================================================

<https://kos.geospecimens.org/org/ben-norton>
    a schema:Person ;
    schema:name "Ben Norton" ;
    schema:identifier <https://orcid.org/0000-0002-5819-9134> ;
    schema:email "ben.norton@yale.edu" ;
    schema:url "https://mbnorton.com"^^xsd:anyURI ;
    schema:parentOrganization <https://kos.geospecimens.org/org/yale-university> ;
    schema:memberOf <https://kos.geospecimens.org/org/minext> ;
    agrelon:hasEmployer <https://kos.geospecimens.org/org/yale-university> ;
    agrelon:isMemberOf <https://kos.geospecimens.org/org/minext> ;
.

<https://kos.geospecimens.org/org/minext>
    a schema:Organization ;
    schema:name "Mineralogy Extension Task Group" ;
    schema:url "https://www.tdwg.org/community/esp/mineralogy/"^^xsd:anyURI ;
    schema:homepage "https://www.tdwg.org/community/esp/mineralogy/"^^xsd:anyURI ;
    cmns-av:acronym "MinExt" ;
    schema:memberOf <https://kos.geospecimens.org/org/tdwg> ;
    org:unitOf <https://kos.geospecimens.org/org/tdwg> ;
.

<https://kos.geospecimens.org/org/tdwg>
    a schema:Organization ;
    schema:name "Biodiversity Information Standards" ;
    schema:url "https://www.tdwg.org"^^xsd:anyURI ;
    schema:homepage "https://www.tdwg.org"^^xsd:anyURI ;
    cmns-av:acronym "TDWG" ;
    rdfs:comment "Taxonomic Databases Working Group, now Biodiversity Information Standards"@en ;
.

<https://kos.geospecimens.org/org/yale-university>
    a schema:Organization ;
    schema:name "Yale University" ;
    schema:url "https://www.yale.edu"^^xsd:anyURI ;
    schema:homepage "https://www.yale.edu"^^xsd:anyURI ;
    rdfs:comment "Also identified by GBIF GRSciColl IRI: https://scientific-collections.gbif.org/institution/75f50140-830d-4630-a290-3d6e951a7c29"@en ;
.


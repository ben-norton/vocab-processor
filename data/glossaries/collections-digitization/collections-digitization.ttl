    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/requirements>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Requirements"@en ;
    skos:definition          """A proposition that states a set of conditions that have to be fulfilled to achieve some specific objective."""@en ;
    skos:notation            "requirements" ;
    dcterms:identifier       "requirements" ;
    dcterms:source           "Allotrope Foundation Ontology" ;
    rdfs:seeAlso             <http://purl.allotrope.org/ontologies/result#AFR_0001872> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-lifecycle>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Data Lifecycle"@en ;
    skos:definition          """Entire period of time that data exists. This life cycle describes the flow of data starting from planning, collecting, processing, analysing, preserving, sharing and finally reusing the data."""@en ;
    skos:notation            "data-lifecycle" ;
    dcterms:identifier       "data-lifecycle" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000213> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-management-plan>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Data Management Plan"@en ;
    skos:definition          """Statement describing how data will be managed throughout a specified life cycle including terms regarding archiving and potential preservation of the data in a data repository. The plan is considered to be a 'living' document, i.e. one which can be updated when necessary."""@en ;
    skos:notation            "data-management-plan" ;
    dcterms:identifier       "data-management-plan" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000196> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-manager>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Data Manager"@en ;
    skos:definition          """A person primarily responsible for database creation, data collection, validation, integration, coding, review, quality evaluation, and archiving, as well as for preparation of reports and data displays."""@en ;
    skos:notation            "data-manager" ;
    dcterms:identifier       "data-manager" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/NCIT_C51820> ;

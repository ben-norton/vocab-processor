    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/agent>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Agent"@en ;
    skos:definition          """An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity."""@en ;
    skos:scopeNote           "Agents typically persons, organizations, or software that perform tasks, including making assertions, or generating information used as evidence. In the execution of such tasks, an 'agent role' is realized that inheres in the agent."@en ;
    skos:notation            "agent" ;
    dcterms:identifier       "agent" ;
    dcterms:source           "PROV-O: The PROV Ontology" ;
    rdfs:seeAlso             <http://www.w3.org/ns/prov#Agent> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;

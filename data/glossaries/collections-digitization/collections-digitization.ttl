    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/collection-management-system>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Collection Management System"@en ;
    skos:definition          """An integrated software tool with a metadata structure specifically designed for capturing, curating, preserving, and accessing data associated with museum collections"""@en ;
    skos:notation            "collection-management-system" ;

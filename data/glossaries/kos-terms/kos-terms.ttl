    dcterms:modified         "2026-06-10"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/glossary/kos-terms> ;
    skos:topConceptOf        <https://kos.geospecimens.org/glossary/kos-terms> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/list>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "List"@en ;
    skos:definition          """A limited set of terms arranged as a simple alphabetical list or in some other logically evident way; containing no relationships of any kind"""@en ;
    skos:notation            "list" ;
    dcterms:identifier       "list" ;

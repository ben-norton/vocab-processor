<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/activity>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Activity"@en ;
    skos:definition          """An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities."""@en ;
    skos:notation            "activity" ;
    dcterms:identifier       "activity" ;
    dcterms:source           "PROV-O: The PROV Ontology" ;
    rdfs:seeAlso             <http://www.w3.org/ns/prov#Activity> ;

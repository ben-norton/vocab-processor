    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-policy>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Data Policy"@en ;
    skos:definition          """Set of high-level principles that establish a guiding framework for data-related issues."""@en ;
    skos:scopeNote           "A data policy may contain subsidiary sections that define approaches to strategic aspects such as data access; data protection; data management, custodianship or stewardship; data preservation; relevant legal matters; data acquisition; data ethics and other data-related issues. Distinct from a data management policy which is the subset of data policy addressing the management of a specified set of data assets."@en ;
    skos:notation            "data-policy" ;
    dcterms:identifier       "data-policy" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000333> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-preparation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Preparation"@en ;
    skos:definition          """Data preparation is the process of manipulating (or pre-processing) data (which may come from disparate data sources) to improve their quality or reduce bias in subsequent analysis."""@en ;
    skos:notation            "data-preparation" ;
    dcterms:identifier       "data-preparation" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-product>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Data Product"@en ;
    skos:definition          """A collection of one or more data items that are packaged for or by a specific application."""@en ;
    skos:scopeNote           "A data product may have input and output ports, code and metadata"@en ;
    skos:notation            "data-product" ;
    dcterms:identifier       "data-product" ;
    dcterms:source           "Adopted from ISO 21961:2003, https://www.ica.org/standards/RiC/ontology#DataProduct" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-product-specification>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Data Product Specification"@en ;
    skos:definition          """Detailed description of a dataset or dataset series together with additional information that will enable it to be created, supplied to and used by another party"""@en ;
    skos:notation            "data-product-specification" ;
    dcterms:identifier       "data-product-specification" ;
    dcterms:source           "ISO 19126:2021(en) Geographic information — Feature concept dictionaries and registers" ;
    rdfs:seeAlso             <https://www.iso.org/standard/78898.html> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;

<https://kos.geospecimens.org/glossary/kos-terms/term/hierarchical-relationship>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Hierarchical Relationship"@en ;
    skos:definition          """A relationship between or among terms in a controlled vocabulary that depicts broader (generic) to narrower (specific) or whole-part relationships; begins with the words broader term (BT), or narrower term (NT)."""@en ;
    skos:notation            "hierarchical-relationship" ;
    dcterms:identifier       "hierarchical-relationship" ;

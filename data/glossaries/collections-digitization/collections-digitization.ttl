    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/source-data-verification>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Source Data Verification"@en ;
    skos:definition          """Confirming the accuracy, authenticity, and thoroughness of information by comparing it to original information and records."""@en ;
    skos:notation            "source-data-verification" ;
    dcterms:identifier       "source-data-verification" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-profiling>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Profiling"@en ;
    skos:definition          """The statistical analysis and assessment of the quality of data values within a dataset for consistency, uniqueness and logic."""@en ;
    skos:scopeNote           "The data profiling process cannot identify inaccurate data; it can only identify business rules violations and anomalies."@en ;
    skos:notation            "data-profiling" ;
    dcterms:identifier       "data-profiling" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000516> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-provider>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Data Provider"@en ;
    skos:definition          """An agent or agents that produces data or reference metadata"""@en ;
    skos:notation            "data-provider" ;
    dcterms:identifier       "data-provider" ;
    dcterms:source           "ISO 17369:2013(en) Statistical data and metadata exchange (SDMX)" ;
    rdfs:seeAlso             <https://www.iso.org/standard/52500.html> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-publication-workflow>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Publication Workflow"@en ;
    skos:definition          """Activities and processes in a digital environment that lead to the publication of data, associated metadata and accompanying documentation as a web-based resource."""@en ;
    skos:notation            "data-publication-workflow" ;
    dcterms:identifier       "data-publication-workflow" ;
    dcterms:source           "Adopted from http://purl.obolibrary.org/obo/T4FS_0000190" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-publishing>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Publishing"@en ;
    skos:definition          """Process whereby data are subjected to an assessment process to determine whether they should be acquired by a repository; followed by a rigorous acquisition and ingest process that results in products being publicly made available and supported for the long-term by that repository."""@en ;
    skos:notation            "data-publishing" ;
    dcterms:identifier       "data-publishing" ;
    dcterms:source           "ISO 5127:2017(en) Information and documentation — Foundation and vocabulary" ;
    rdfs:seeAlso             <https://www.iso.org/standard/59743.html> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-quality>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Data Quality"@en ;
    skos:definition          """The reliability and application efficiency of data."""@en ;
    skos:notation            "data-quality" ;
    dcterms:identifier       "data-quality" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000507> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-steward>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Data Steward"@en ;
    skos:definition          """Role within an organization responsible for ensuring metadata quality, integrity, and access in a manner that is consistent with policies and practices established through data governance to ensure the data is fit for reuse."""@en ;
    skos:notation            "data-steward" ;
    dcterms:identifier       "data-steward" ;
    dcterms:source           "Adopted from ISO/TR 14872:2019 and http://purl.obolibrary.org/obo/T4FS_0000178, Thomas G (2009)" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-transformation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Transformation"@en ;
    skos:definition          """A process whereby data is changed from one format or structure to another."""@en ;
    skos:notation            "data-transformation" ;
    dcterms:identifier       "data-transformation" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/NCIT_C43582> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-validation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Validation"@en ;
    skos:definition          """Process used to determine if data are inaccurate, incomplete, or unreasonable."""@en ;
    skos:scopeNote           "The process may include format checks, completeness checks, check key tests, reasonableness checks, limit checks, and checking for compliance with applicable standards, rules, and conventions."@en ;
    skos:notation            "data-validation" ;
    dcterms:identifier       "data-validation" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000238> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/dataset>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Dataset"@en ;
    skos:definition          """An identifiable collection of data"""@en ;
    skos:example             "Data products such as images, catalogs, parameter files, calibration data, instrument characteristics, articles, and web pages"@en ;
    skos:notation            "dataset" ;
    dcterms:identifier       "dataset" ;
    dcterms:source           "ISO 19101-1:2014(en) Geographic information — Reference model — Part 1: Fundamentals" ;
    rdfs:seeAlso             <https://www.iso.org/standard/78898.html> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/deaccession>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Deaccession"@en ;
    skos:definition          """The formal, documented process by which a museum or institution permanently removes an object from its permanent collection."""@en ;
    skos:scopeNote           "An accession is guided by internal policy, professional ethics, and often oversight by governing boards or curatorial committees."@en ;
    skos:notation            "deaccession" ;
    dcterms:identifier       "deaccession" ;
    dcterms:source           "Art Glossary: Definitions of Common Art Terms and Techniques" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/derivation>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Derivation"@en ;
    skos:definition          """A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."""@en ;
    skos:scopeNote           "For an entity to be transformed from, created from, or resulting from an update to another, there must be some underpinning activity or activities performing the necessary action(s) resulting in such a derivation."@en ;
    skos:notation            "derivation" ;
    dcterms:identifier       "derivation" ;
    dcterms:source           "The PROV Namespace" ;
    rdfs:seeAlso             <http://www.w3.org/ns/prov#Derivation> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/determination>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Determination"@en ;
    skos:definition          """The systematic identification and classification of a collection object"""@en ;
    skos:scopeNote           "A action of making a determination is independent of the accession status of a specimen."@en ;
    skos:notation            "determination" ;
    dcterms:identifier       "determination" ;
    dcterms:source           "CIDOC Conceptual Reference Model version 7.1.3" ;
    rdfs:seeAlso             <http://www.cidoc-crm.org/cidoc-crm/E17_Type_Assignment> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/digital-collections>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Digital Collections"@en ;
    skos:definition          """Designates an aggregation of digital objects, including digital versions of physical media, digitised resources, or born-digital items. The collection may be online presented or not."""@en ;
    skos:scopeNote           "Disambiguates Collection terms in the LIDO ObjectType vocabulary. Here, Digital Collections are disambiguated from Physical and Online Collections"@en ;
    skos:notation            "digital-collections" ;
    dcterms:identifier       "digital-collections" ;
    dcterms:source           "Lightweight Information Describing Objects" ;
    rdfs:seeAlso             <http://terminology.lido-schema.org/lido01032> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/doi>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Digital Object Identifier"@en ;
    skos:definition          """Persistent identifiers standardized by the ISO. DOIs a re an implementation of the handle system and adhere to the URI (Universal Resource Identifier) system. Notation: DOI"""@en ;
    skos:example             "https://doi.org/10.1000/182"@en ;
    skos:notation            "doi" ;
    dcterms:identifier       "doi" ;
    dcterms:source           "https://www.doi.org/, ISO 26324:2025 Information and documentation—Digital object identifier system" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/digitization>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Digitization"@en ;
    skos:definition          """Process of converting analogue materials into digital form"""@en ;
    skos:notation            "digitization" ;
    dcterms:identifier       "digitization" ;
    dcterms:source           "ISO 21246:2019 Information and documentation — Key indicators for museums" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/backlog>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Digitization Backlog"@en ;
    skos:definition          """Accessioned collection objects for which digitization has not yet begun — meaning no specimen metadata has been captured in a collections management system or similar software."""@en ;
    skos:scopeNote           "In the broadest sense of the term, the backlog consists of incomplete digital records, which prohibits the digitization process from advancing to the data curation and archival phase."@en ;
    skos:notation            "backlog" ;
    dcterms:identifier       "backlog" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/distribution>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Distribution"@en ;
    skos:definition          """A specific serialized representation of a dataset."""@en ;
    skos:scopeNote           "A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above)."@en ;
    skos:notation            "distribution" ;
    dcterms:identifier       "distribution" ;
    dcterms:source           "Adopted from http://schema.org/distribution and https://www.w3.org/ns/dcat#Distribution" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/distribution-phase>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Distribution Phase"@en ;
    skos:definition          """The stage in a project when a serialized version of a mobilized dataset is made available"""@en ;
    skos:notation            "distribution-phase" ;
    dcterms:identifier       "distribution-phase" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/entity>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Entity"@en ;
    skos:definition          """An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary."""@en ;
    skos:notation            "entity" ;
    dcterms:identifier       "entity" ;
    dcterms:source           "PROV-O" ;
    rdfs:seeAlso             <http://www.w3.org/ns/prov#Entity> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/environmental-science>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Environmental Science"@en ;
    skos:definition          """Environmental science is the science of the interactions between the physical, chemical, and biological components of the environment, but with particular attention to the effects of humans on the natural environment."""@en ;
    skos:scopeNote           "Subclass of Earth Science"@en ;
    skos:notation            "environmental-science" ;
    dcterms:identifier       "environmental-science" ;
    dcterms:source           "Modern Science Ontology" ;
    rdfs:seeAlso             <https://w3id.org/skgo/modsci#EnvironmentalScience> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/event>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Event"@en ;
    skos:definition          """Something that happens or occurs in time and space."""@en ;
    skos:scopeNote           "An event may be caused by nature, an agent, or a combination of nature and agent. Events have temporal and spatial boundaries. An event may actively involve some agent(s) and affect any entity. An event may be discrete, happening at a specific moment in time, or may occur over an extended period of time. Events may have events as parts, and events may precede or follow one another. Multiple agents may participate in the same event, and in different roles."@en ;
    skos:notation            "event" ;
    dcterms:identifier       "event" ;
    dcterms:source           "International Council on Archives Records in Contexts Ontology (ICA RiC-O) version 1.1" ;
    rdfs:seeAlso             <https://www.ica.org/standards/RiC/ontology#Event> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/event-type>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Event Type"@en ;
    skos:definition          """Categorization scheme for grouping events by purpose"""@en ;
    skos:scopeNote           "Curation event types include creation; acquisition; transfer; arrangement; description; digitization, etc. Biographical event types include birth, marriage, death, etc."@en ;
    skos:notation            "event-type" ;
    dcterms:identifier       "event-type" ;
    dcterms:source           "International Council on Archives Records in Contexts Ontology (ICA RiC-O) version 1.1" ;
    rdfs:seeAlso             <https://www.ica.org/standards/RiC/ontology#EventType> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/extract-transform-load>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Extract Transform Load"@en ;
    skos:definition          """A planned data integration process that extracts concretizations of information from a data source, prepares and transforms them, then loads the transformed concretizations into a target data store."""@en ;
    skos:notation            "extract-transform-load" ;
    dcterms:identifier       "extract-transform-load" ;
    dcterms:source           "Adopted from http://purl.obolibrary.org/obo/IAO_0000650 and http://purl.obolibrary.org/obo/NCIT_C142549" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/fair-principles>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "FAIR Principles"@en ;
    skos:definition          """The FAIR principles are guidelines to improve the Findability, Accessibility, Interoperability, and Reuse of digital assets. The principles emphasise machine-actionability (i.e., the capacity of computational systems to find, access, interoperate, and reuse data with none or minimal human intervention) because humans increasingly rely on computational support to deal with data as a result of the increase in volume, complexity, and creation speed of data. The principles refer to three types of entities: data (or any digital object), metadata (information about that digital object), and infrastructure."""@en ;
    skos:notation            "fair-principles" ;
    dcterms:identifier       "fair-principles" ;
    dcterms:source           "terms4FAIRskills" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/T4FS_0000447> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/feature-of-interest>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Feature of Interest"@en ;
    skos:definition          """The thing being sampled or transformed in an act of sampling."""@en ;
    skos:notation            "feature-of-interest" ;
    dcterms:identifier       "feature-of-interest" ;
    dcterms:source           "Semantic Sensor Network Ontology" ;
    rdfs:seeAlso             <https://www.w3.org/TR/vocab-ssn/#SOSAFeatureOfInterest> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/field>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Field"@en ;
    skos:definition          """User-interface element in which data is entered or presented"""@en ;
    skos:notation            "field" ;
    dcterms:identifier       "field" ;
    dcterms:source           "ISO 9241-125:2017(en) Ergonomics of human-system interaction — Part 125: Guidance on visual presentation of information" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/field-work>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Field Work"@en ;
    skos:definition          """Investigation or other type of formal activity practiced by direct observation in the field as a form of primary reconnaissance"""@en ;
    skos:notation            "field-work" ;
    dcterms:identifier       "field-work" ;
    dcterms:source           "This Document and adopted from ISO 22932-2:2020" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/format-transformation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Format Transformation"@en ;
    skos:definition          """A type of data transformation that preserves the content of a dataset while converting its representation format."""@en ;
    skos:notation            "format-transformation" ;
    dcterms:identifier       "format-transformation" ;
    dcterms:source           "Adopted from http://purl.org/net/wf-motifs#FormatTransformation" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/fossil>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Fossil"@en ;
    skos:definition          """Any remains, trace, or imprint of a plant or animal preserved in the Earth's crust since some past geologic or prehistoric time; loosely, any evidence of past life."""@en ;
    skos:notation            "fossil" ;
    dcterms:identifier       "fossil" ;
    dcterms:source           "Neuendorf et al. (2005)" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/functional-specification>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Functional Specification"@en ;
    skos:definition          """A functional specification is a specification that describes the characteristics of an object."""@en ;
    skos:example             "Subclass of Specification"@en ;
    skos:notation            "functional-specification" ;
    dcterms:identifier       "functional-specification" ;
    dcterms:source           "Semanticscience Integrated Ontology" ;
    rdfs:seeAlso             <http://semanticscience.org/resource/SIO_000315> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/generated>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Generated"@en ;
    skos:definition          """The completion of production of a new entity by an activity."""@en ;
    skos:scopeNote           "This entity did not exist before generation and becomes available for usage after this generation. Given that a generation is the completion of production of an entity, it is instantaneous."@en ;
    skos:notation            "generated" ;
    dcterms:identifier       "generated" ;
    dcterms:source           "W3C PROV Data Model Activity concepts" ;
    rdfs:seeAlso             <http://hl7.org/fhir/w3c-provenance-activity-type/generation> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/geological-collection>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Geological Collection"@en ;
    skos:definition          """A museum collection comprised predominantly of geological materials."""@en ;
    skos:notation            "geological-collection" ;
    dcterms:identifier       "geological-collection" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/geological-material>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Geological Material"@en ;
    skos:definition          """A material entity comprised of a natural amount of matter generated by some geologic process"""@en ;
    skos:scopeNote           "Can include minor parts that are not of geologic origin, such as organic material, and can be solid, fluid, or a mix."@en ;
    skos:notation            "geological-material" ;
    dcterms:identifier       "geological-material" ;
    dcterms:source           "Adopted from GeoCore Ontology and Geosciences Ontology" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/geologic-specimen>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Geological Specimen"@en ;
    skos:definition          """A collection object that is a geologic material"""@en ;
    skos:notation            "geologic-specimen" ;
    dcterms:identifier       "geologic-specimen" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/geology>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Geology"@en ;
    skos:definition          """Study of the planet earth, its composition, structure, physical and chemical processes, and history since its origin."""@en ;
    skos:notation            "geology" ;
    dcterms:identifier       "geology" ;
    dcterms:source           "USGS Thesaurus" ;
    rdfs:seeAlso             <https://apps.usgs.gov/thesaurus/USGSThesaurus/geology> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/glossary>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Glossary"@en ;
    skos:definition          """A collection of defined concepts within a domain"""@en ;
    skos:notation            "glossary" ;
    dcterms:identifier       "glossary" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/NCIT_C18232> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;

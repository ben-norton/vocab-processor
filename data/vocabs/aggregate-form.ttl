<https://kos.resources.org/def/aggregate-form>
    a                        skos:ConceptScheme ;
    skos:prefLabel           "Aggregate Form"@en ;
    dcterms:title            "Aggregate Form"@en ;
    skos:definition          """Aggregate Form is a SKOS concept scheme that enumerates the characteristic macroscopic forms adopted by mineral specimens when individual crystals or grains grow together as a collective mass. The vocabulary describes the overall three-dimensional architecture of a mineral aggregate — the arrangement, orientation, and shape of its constituent grains or crystals — as distinct from the crystallographic form of a single crystal or the bulk rock texture of a hand specimen."""@en ;
    dcterms:description      """Aggregate Form is a SKOS concept scheme that enumerates the characteristic macroscopic forms adopted by mineral specimens when individual crystals or grains grow together as a collective mass. The vocabulary describes the overall three-dimensional architecture of a mineral aggregate — the arrangement, orientation, and shape of its constituent grains or crystals — as distinct from the crystallographic form of a single crystal or the bulk rock texture of a hand specimen."""@en ;
    dcterms:publisher        <https://orcid.org/0000-0002-5819-9134> ;
    dcterms:creator          <https://orcid.org/0000-0002-5819-9134> ;
    dcterms:contributor      _:agent_mineralogy_extension_task_group ;
    dcterms:provenance       "Most values represent aggregations of multiple resources except for values with the specific source 'Chesterman, C. W. (1978). National Audubon Society field guide to rocks and minerals: North America. Knopf.'"@en ;
    dcterms:created          "2026-05-06"^^xsd:date ;
    dcterms:modified         "2026-05-06"^^xsd:date ;
    dcat:version             "2026-05-06" ;
    skos:scopeNote           "This vocabulary applies to specimens where the dominant observable character is the habit of the aggregate as a whole rather than the form of any single crystal."@en ;
    vann:usageNote           "Term from this vocabulary should be applied when describing the characteristic form of the mineral aggregate visible at the hand-specimen scale. A single specimen may legitimately receive more than one term where distinct aggregate forms co-occur"@en ;
    dcat:keyword             "Mineralogical Collection"@en ,
                             "Mineral Properties"@en ,
                             "Minerals"@en ;
    schema:citation          "Norton B, Walcott R, Burri T, Puschnig A, Dombrowski A, Greber N, Hints O, Mansur A, Ralph J, Richard S, Tacker C. Geological Material Sample Type Vocabulary (pending)."@en ;
    schema:license           <https://creativecommons.org/licenses/by/4.0/> ;
    reg:derivationMode       <https://linked.data.gov.au/def/vocdermods/subsetting-and-extension> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    skos:hasTopConcept       <https://kos.resources.org/def/aggregate-form/acicular> ,
                             <https://kos.resources.org/def/aggregate-form/banded> ,
                             <https://kos.resources.org/def/aggregate-form/botryoidal> ,
                             <https://kos.resources.org/def/aggregate-form/columnar> ,
                             <https://kos.resources.org/def/aggregate-form/concentric> ,
                             <https://kos.resources.org/def/aggregate-form/coxcomb> ,
                             <https://kos.resources.org/def/aggregate-form/dendritic> ,
                             <https://kos.resources.org/def/aggregate-form/druse> ,
                             <https://kos.resources.org/def/aggregate-form/fibrous> ,
                             <https://kos.resources.org/def/aggregate-form/geode> ,
                             <https://kos.resources.org/def/aggregate-form/granular> ,
                             <https://kos.resources.org/def/aggregate-form/mammillary> ,
                             <https://kos.resources.org/def/aggregate-form/massive> ,
                             <https://kos.resources.org/def/aggregate-form/micaceous> ,
                             <https://kos.resources.org/def/aggregate-form/oolitic> ,
                             <https://kos.resources.org/def/aggregate-form/pisolitic> ,
                             <https://kos.resources.org/def/aggregate-form/radiating> ,
                             <https://kos.resources.org/def/aggregate-form/reniform> ,
                             <https://kos.resources.org/def/aggregate-form/stalactitic> ,
                             <https://kos.resources.org/def/aggregate-form/wheat-sheaf> ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://orcid.org/0000-0002-5819-9134> ;
        dcat:hadRole     isoroles:editor , isoroles:publisher , isoroles:editor , isoroles:publisher ;
    ] ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       _:agent_biodiversity_information_standards ;
        dcat:hadRole     isoroles:unknown ;
    ] ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       _:agent_mineralogy_extension_task_group ;
        dcat:hadRole     isoroles:contributor , isoroles:custodian ;
    ] ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       _:agent_yale_university ;
        dcat:hadRole     isoroles:unknown ;
    ] ;
.


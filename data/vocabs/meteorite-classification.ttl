    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:h-l-ll-clan ;
    xkos:specializes mc:chondrites ;
    skos:broader mc:chondrites ;
    skos:definition "The most abundant chondrites (>85% of falls); abundant large chondrules, low matrix, refractory-lithophile abundances below CI, O-isotopes above the TF line. The three groups form one clan."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:h-l-ll-clan ;
    skos:notation "Ordinary" ;
    skos:prefLabel "Ordinary chondrites"@en .

mc:acapulcoite-lodranite-clan a skos:Concept ;
    dct:identifier "acapulcoite-lodranite-clan" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:acapulcoite,
        mc:lodranite ;
    xkos:specializes mc:primitive-achondrites ;
    skos:broader mc:primitive-achondrites ;
    skos:definition "Acapulcoite-Lodranite clan; primitive achondrites with similar, spread O-isotopes; residues/products of low-degree partial melting of a chondritic precursor."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:acapulcoite,
        mc:lodranite ;
    skos:notation "ACA-LOD" ;
    skos:prefLabel "Acapulcoite-Lodranite clan"@en .

mc:cb-bencubbin-type a skos:Concept ;
    dct:identifier "cb-bencubbin-type" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:cb-subgroup-a,
        mc:cb-subgroup-b ;
    xkos:specializes mc:cr-clan ;
    skos:broader mc:cr-clan ;
    skos:definition "Bencubbin-type; extreme metal (60-80 vol%), cryptocrystalline/barred chondrules, strong volatile-lithophile depletion and heavy-N enrichment; subgroups CBa and CBb."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:cb-subgroup-a,
        mc:cb-subgroup-b ;
    skos:notation "CB" ;
    skos:prefLabel "CB (Bencubbin-type)"@en .

mc:cm-co-clan a skos:Concept ;
    dct:identifier "cm-co-clan" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:cm-mighei-type,
        mc:co-ornans-type ;
    xkos:specializes mc:carbonaceous-chondrites ;
    skos:broader mc:carbonaceous-chondrites ;
    skos:definition "Clan linking the CM and CO groups by similar chondrule sizes, refractory-lithophile abundances, and high-temperature-mineral O-isotopes."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:cm-mighei-type,
        mc:co-ornans-type ;
    skos:notation "CM-CO" ;
    skos:prefLabel "CM-CO clan"@en .

mc:cv-ck-clan a skos:Concept ;
    dct:identifier "cv-ck-clan" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:ck-karoonda-type,
        mc:cv-vigarano-type ;
    xkos:specializes mc:carbonaceous-chondrites ;
    skos:broader mc:carbonaceous-chondrites ;
    skos:definition "Clan grouping CV and CK chondrites, which share overlapping CCAM-line O-isotopes and magnetite chemistry; low-type CK resembles oxidized CV."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:ck-karoonda-type,
        mc:cv-vigarano-type ;
    skos:notation "CV-CK" ;
    skos:prefLabel "CV-CK clan"@en .

mc:eh-el-clan a skos:Concept ;
    dct:identifier "eh-el-clan" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:eh-high-iron,
        mc:el-low-iron ;
    xkos:specializes mc:enstatite-chondrites ;
    skos:broader mc:enstatite-chondrites ;
    skos:definition "Single enstatite-chondrite clan; EH and EL are distinguished mainly by sulfide chemistry and metal Si content."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:eh-high-iron,
        mc:el-low-iron ;
    skos:notation "EH-EL" ;
    skos:prefLabel "EH-EL clan"@en .

mc:meteorites a skos:Concept ;
    dct:identifier "meteorites" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:achondrites,
        mc:chondrites,
        mc:primitive-achondrites ;
    skos:definition "Solid extraterrestrial fragments that survive atmospheric passage; classified by mineralogy, petrography, bulk chemistry and O-isotopes into chondrites, primitive achondrites and achondrites."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:achondrites,
        mc:chondrites,
        mc:primitive-achondrites ;
    skos:notation "Meteorites" ;
    skos:prefLabel "Meteorites"@en ;
    skos:topConceptOf <https://kos.geospecimens.org/def/meteorite-classification> .

mc:cr-clan a skos:Concept ;
    dct:identifier "cr-clan" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:cb-bencubbin-type,
        mc:ch-high-metal,
        mc:cr-renazzo-type ;
    xkos:specializes mc:carbonaceous-chondrites ;
    skos:broader mc:carbonaceous-chondrites ;
    skos:definition "Clan of the metal-rich CR, CH and CB groups (plus ungrouped LEW 85332), united by solar-Ni/Co metal, strong volatile-lithophile depletions, CR-line O-isotopes, and large d15N anomalies."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:cb-bencubbin-type,
        mc:ch-high-metal,
        mc:cr-renazzo-type ;
    skos:notation "CR" ;
    skos:prefLabel "CR clan"@en .

mc:cv-vigarano-type a skos:Concept ;
    dct:identifier "cv-vigarano-type" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:cv-subgroup-a-oxidized-allende-like,
        mc:cv-subgroup-b-oxidized-bali-like,
        mc:cv-subgroup-reduced ;
    xkos:specializes mc:cv-ck-clan ;
    skos:broader mc:cv-ck-clan ;
    skos:definition "Vigarano-type; abundant matrix, large (~1 mm) chondrules and abundant large CAIs/AOAs; all type 3, divided into oxidized and reduced subgroups."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:cv-subgroup-a-oxidized-allende-like,
        mc:cv-subgroup-b-oxidized-bali-like,
        mc:cv-subgroup-reduced ;
    skos:notation "CV" ;
    skos:prefLabel "CV (Vigarano-type)"@en .

mc:h-l-ll-clan a skos:Concept ;
    dct:identifier "h-l-ll-clan" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:h-high-iron,
        mc:l-low-iron,
        mc:ll-low-iron-low-metal ;
    xkos:specializes mc:ordinary-chondrites ;
    skos:broader mc:ordinary-chondrites ;
    skos:definition "Single ordinary-chondrite clan; H, L and LL overlap in O-isotopes and petrology, indicating close kinship."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:h-high-iron,
        mc:l-low-iron,
        mc:ll-low-iron-low-metal ;
    skos:notation "H-L-LL" ;
    skos:prefLabel "H-L-LL clan"@en .

mc:hed-clan-vesta a skos:Concept ;
    dct:identifier "hed-clan-vesta" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:diogenite,
        mc:eucrite,
        mc:howardite ;
    xkos:specializes mc:achondrites ;
    skos:broader mc:achondrites ;
    skos:definition "HED clan (howardites-eucrites-diogenites); basalts and orthopyroxene cumulates from a common asteroidal parent, sharing O-isotopes and pyroxene Fe/Mn; spectrally linked to asteroid 4 Vesta."@en ;
    skos:editorialNote "howardite-eucrite-diogenite; parent body inferred as Vesta"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:diogenite,
        mc:eucrite,
        mc:howardite ;
    skos:notation "Vesta?" ;
    skos:prefLabel "HED clan (Vesta)"@en .

mc:pallasites a skos:Concept ;
    dct:identifier "pallasites" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:eagle-station-pallasite,
        mc:main-group-pallasite,
        mc:pyroxene-pallasite ;
    xkos:specializes mc:achondrites ;
    skos:broader mc:achondrites ;
    skos:definition "Pallasites; olivine-metal (+troilite) stony-irons. 'Pallasite' is essentially a textural term: the main-group, Eagle Station and pyroxene pallasites (plus ungrouped Milton) formed on separate parent bodies and do not form a true clan/group."@en ;
    skos:editorialNote "Unlabeled shared connector in figure (clan-row grouping)"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:eagle-station-pallasite,
        mc:main-group-pallasite,
        mc:pyroxene-pallasite ;
    skos:notation "PAL" ;
    skos:prefLabel "Pallasites"@en .

mc:winonaite-iab-iiicd-clan a skos:Concept ;
    dct:identifier "winonaite-iab-iiicd-clan" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:iab-iron-silicate-bearing,
        mc:iiicd-iron-silicate-bearing,
        mc:winonaite ;
    xkos:specializes mc:primitive-achondrites ;
    skos:broader mc:primitive-achondrites ;
    skos:definition "Winonaite-IAB-IIICD clan; silicate mineralogy and O-isotopes link winonaites to silicate inclusions in IAB (and possibly IIICD) irons, implying a shared or similar parent body."@en ;
    skos:editorialNote "Clan box reads 'WIN-IAB-IICD' in figure"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:iab-iron-silicate-bearing,
        mc:iiicd-iron-silicate-bearing,
        mc:winonaite ;
    skos:notation "WIN-IAB-IIICD" ;
    skos:prefLabel "Winonaite-IAB-IIICD clan"@en .

mc:rank a skos:ConceptScheme ;
    dct:created "2026-06-11"^^xsd:date ;
    dct:creator <https://kos.geospecimens.org/def/meteorite-classification/agent/geospecimens> ;
    dct:description "The five hierarchy ranks used by the Weisberg, McCoy & Krot (2006) meteorite classification, in descending order: division (highest; children of the root, Meteorites), class, clan, group, subgroup. Ordered by skos:notation and linked by xkos:next / xkos:previous; referenced by the classification levels via xkos:organizedBy."@en ;
    dct:identifier mc:rank ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:modified "2026-06-11"^^xsd:date ;
    dct:publisher <https://kos.geospecimens.org/def/meteorite-classification/agent/geospecimens> ;
    dct:title "Meteorite classification ranks"@en ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:contains mcrank:clan,
        mcrank:class,
        mcrank:division,
        mcrank:group,
        mcrank:subgroup ;
    xkos:numberOfLevels "1"^^xsd:positiveInteger ;
    skos:hasTopConcept mcrank:clan,
        mcrank:class,
        mcrank:division,
        mcrank:group,
        mcrank:subgroup .

mcref:scottwasson1975 a dct:BibliographicResource ;
    rdfs:label "Scott & Wasson (1975)"@en ;
    dct:bibliographicCitation "Scott E. R. D. and Wasson J. T. (1975) Classification and properties of iron meteorites. Reviews of Geophysics and Space Physics, 13(4), 527-546."@en ;
    dct:identifier <https://doi.org/10.1029/RG013i004p00527> .

mcref:wassonironseries a dct:BibliographicResource ;
    rdfs:label "Wasson iron-classification series"@en ;
    dct:bibliographicCitation "Wasson J. T. and coworkers (1967-1976) 'The chemical classification of iron meteorites' (multi-part series), Geochimica et Cosmochimica Acta; e.g. Wasson J. T. and Kimberlin J. (1967) Part II, GCA 31, 149-178."@en .

mc:carbonaceous-chondrites a skos:Concept ;
    dct:identifier "carbonaceous-chondrites" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:ci-clan,
        mc:cm-co-clan,
        mc:cr-clan,
        mc:cv-ck-clan ;
    xkos:specializes mc:chondrites ;
    skos:broader mc:chondrites ;
    skos:definition "Chondrite class with Mg-normalized refractory-lithophile abundances at or above CI and O-isotopes plotting near or below the terrestrial fractionation line; eight groups."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:ci-clan,
        mc:cm-co-clan,
        mc:cr-clan,
        mc:cv-ck-clan ;
    skos:notation "Carbonaceous" ;
    skos:prefLabel "Carbonaceous chondrites"@en .

mc:martian-snc a skos:Concept ;
    dct:identifier "martian-snc" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:chassignite,
        mc:nakhlite,
        mc:orthopyroxenite,
        mc:shergottite ;
    xkos:specializes mc:achondrites ;
    skos:broader mc:achondrites ;
    skos:definition "Martian (SNC) meteorites; crustal igneous rocks from Mars defining a unique slope-0.52 O-isotope line, with trapped gases matching the martian atmosphere. Includes shergottites, nakhlites, chassignites and orthopyroxenite ALH 84001."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:chassignite,
        mc:nakhlite,
        mc:orthopyroxenite,
        mc:shergottite ;
    skos:notation "Mars" ;
    skos:prefLabel "Martian (SNC)"@en .

mc:primitive-achondrites a skos:Concept ;
    dct:identifier "primitive-achondrites" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:acapulcoite-lodranite-clan,
        mc:brachinite,
        mc:ureilite,
        mc:winonaite-iab-iiicd-clan ;
    xkos:specializes mc:meteorites ;
    skos:broader mc:meteorites ;
    skos:definition "Nonchondritic meteorites with igneous or recrystallized textures that retain a chemical/isotopic affinity to chondritic precursors; interpreted as residues or low-degree partial melts that did not fully differentiate."@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:acapulcoite-lodranite-clan,
        mc:brachinite,
        mc:ureilite,
        mc:winonaite-iab-iiicd-clan ;
    skos:notation "Primitive Achondrites" ;
    skos:prefLabel "Primitive achondrites"@en .

mc:chondrites a skos:Concept ;
    dct:identifier "chondrites" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:carbonaceous-chondrites,
        mc:enstatite-chondrites,
        mc:k-kakangari-type,
        mc:ordinary-chondrites,
        mc:r-rumuruti-type ;
    xkos:specializes mc:meteorites ;
    skos:broader mc:meteorites ;
    skos:definition "Undifferentiated meteorites with broadly solar (CI-like) bulk compositions minus the most volatile elements, from bodies that never underwent planetary melting; most contain chondrules. 15 groups across the C, O and E classes plus R and K."@en ;
    skos:editorialNote "Division label in figure: Undifferentiated"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:carbonaceous-chondrites,
        mc:enstatite-chondrites,
        mc:k-kakangari-type,
        mc:ordinary-chondrites,
        mc:r-rumuruti-type ;
    skos:notation "Chondrites" ;
    skos:prefLabel "Chondrites"@en .

mc:achondrites a skos:Concept ;
    dct:identifier "achondrites" ;
    dct:source mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:angrite,
        mc:aubrite,
        mc:hed-clan-vesta,
        mc:irons,
        mc:lunar-moon,
        mc:martian-snc,
        mc:mesosiderite,
        mc:pallasites ;
    xkos:specializes mc:meteorites ;
    skos:broader mc:meteorites ;
    skos:definition "Differentiated meteorites - igneous rocks, melt residues, or breccias of igneous fragments - from asteroids, Mars and the Moon that experienced a high degree of melting; includes stones, stony-irons and irons."@en ;
    skos:editorialNote "Division label in figure: Differentiated"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:angrite,
        mc:aubrite,
        mc:hed-clan-vesta,
        mc:irons,
        mc:lunar-moon,
        mc:martian-snc,
        mc:mesosiderite,
        mc:pallasites ;
    skos:notation "Achondrites" ;
    skos:prefLabel "Achondrites"@en .

mc:irons a skos:Concept ;
    dct:identifier "irons" ;
    dct:source mcref:scottwasson1975,
        mcref:wassonironseries,
        mcref:weisberg2006 ;
    reg:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    uneskos:memberOf <https://kos.geospecimens.org/def/meteorite-classification> ;
    xkos:generalizes mc:ic-iron-group,
        mc:iiab-iron-group,
        mc:iic-iron-group,
        mc:iid-iron-group,
        mc:iie-iron-group,
        mc:iiiab-iron-group,
        mc:iiie-iron-group,
        mc:iiif-iron-group,
        mc:iva-iron-group,
        mc:ivb-iron-group ;
    xkos:specializes mc:achondrites ;
    skos:broader mc:achondrites ;
    skos:definition "Iron meteorites; mostly cores of differentiated asteroids. The chemical classification (Scott & Wasson) uses Ga, Ge, Ir and Ni - a Roman numeral plus a letter - resolving 13 groups; ~10 are consistent with fractional crystallization in separate cores, and ~15% of irons (40% in Antarctica) are ungrouped."@en ;
    skos:editorialNote "Unlabeled shared connector in figure (clan-row grouping)"@en ;
    skos:inScheme <https://kos.geospecimens.org/def/meteorite-classification> ;
    skos:narrower mc:ic-iron-group,
        mc:iiab-iron-group,
        mc:iic-iron-group,
        mc:iid-iron-group,
        mc:iie-iron-group,
        mc:iiiab-iron-group,
        mc:iiie-iron-group,
        mc:iiif-iron-group,
        mc:iva-iron-group,
        mc:ivb-iron-group ;
    skos:notation "IRON" ;
    skos:prefLabel "Irons"@en .

mcref:weisberg2006 a dct:BibliographicResource ;
    rdfs:label "Weisberg et al. (2006)"@en ;
    dct:bibliographicCitation "Weisberg M. K., McCoy T. J., and Krot A. N. (2006) Systematics and Evaluation of Meteorite Classification. In Meteorites and the Early Solar System II (D. S. Lauretta and H. Y. McSween Jr., eds.), pp. 19-52. University of Arizona Press, Tucson."@en ;
    dct:identifier <urn:isbn:9780816525621> .

<https://kos.geospecimens.org/def/meteorite-classification> a skos:ConceptScheme ;
    dct:created "2026-06-11"^^xsd:date ;
    dct:creator <https://kos.geospecimens.org/def/meteorite-classification/agent/geospecimens> ;
    dct:description "Hierarchical classification of meteorites after Weisberg M. K., McCoy T. J. and Krot A. N. (2006) Systematics and Evaluation of Meteorite Classification, Fig. 1: chondrites, primitive achondrites and achondrites organized in five ranks (division, class, clan, group, subgroup)."@en ;
    dct:identifier <https://kos.geospecimens.org/def/meteorite-classification> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:modified "2026-06-11"^^xsd:date ;
    dct:publisher <https://kos.geospecimens.org/def/meteorite-classification/agent/geospecimens> ;
    dct:source mcref:weisberg2006 ;
    dct:title "Meteorite Classification (Weisberg, McCoy & Krot 2006)"@en ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/social-sciences>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Social Sciences"@en ;
    skos:definition          """The social sciences are academic disciplines concerned with the study of the social life of human groups and individuals including anthropology, economics, geography, history, political science, psychology, social studies, and sociology."""@en ;
    skos:notation            "social-sciences" ;
    dcterms:identifier       "social-sciences" ;
    dcterms:source           "Modern Science Ontology" ;

# Copy this file to .env (which is gitignored) and set the local path.
# Used by src/sync_to_publisher.py.

# Local path to the vocab-publisher repository root.
# The sync target is <VOCAB_PUBLISHER_PATH>/data
VOCAB_PUBLISHER_PATH=G:\repos\vocabularies\vocab-publisher

# Optional: name the publisher's data directory explicitly instead.
# Takes precedence over VOCAB_PUBLISHER_PATH when set.
# VOCAB_PUBLISHER_DATA_DIR=G:\webserver\Apache\htdocs-apps\geoapis-htdocs\vocab-publisher\data

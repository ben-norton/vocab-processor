.

<https://kos.resources.org/def/aggregate-form/botryoidal>
    a                        skos:Concept ;
    skos:prefLabel           "Botryoidal"@en ;
    skos:definition          """Resembling a bunch of grapes; also called globular (e.g. malachite)."""@en ;
    dcterms:provenance       "Chesterman, C. W. (1978). National Audubon Society field guide to rocks and minerals: North America. Knopf."@en ;
    skos:inScheme            <https://kos.resources.org/def/aggregate-form> ;

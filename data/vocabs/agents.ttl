<https://kos.geospecimens.org/def/aggregate-form>
    a skos:ConceptScheme ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent <https://kos.geospecimens.org/org/ben-norton> ;
        prov:hadRole isoroles:publisher , isoroles:author ;
    ] ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent <https://kos.geospecimens.org/org/minext> ;
        prov:hadRole isoroles:editor , isoroles:custodian ;
    ] ;
.


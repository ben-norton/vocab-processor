    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/glossary/kos-terms/term/http-purl-org-spar-fabio-minimalinformationstandard>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Minimum Information Standard"@en ;
    skos:definition          """A metadata standard specifying items to be included when creating metadata describing a dataset of a particular type, or when creating a structured summary of the main findings of an article or report in a particular domain of interest, thereby ensuring adequate descriptive information is recorded for subsequent resource discovery and/or interpretation of the information described."""@en ;
    skos:notation            "http-purl-org-spar-fabio-minimalinformationstandard" ;
    dcterms:identifier       "http-purl-org-spar-fabio-minimalinformationstandard" ;

    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/concept-harmonization>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Concept Harmonization"@en ;
    skos:definition          """Activity leading to the establishment of a correspondence between two or more closely related or overlapping concepts having in order to eliminate or reduce minor differences between them."""@en ;
    skos:notation            "concept-harmonization" ;
    dcterms:identifier       "concept-harmonization" ;
    dcterms:source           "ISO 19104:2016(en) Geographic information — Terminology" ;
    rdfs:seeAlso             <https://www.iso.org/standard/63541.html> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/conservator>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Conservator"@en ;
    skos:definition          """Person who performs the operations necessary to maintain the integrity and value of material objects in an information and documentation organization"""@en ;
    skos:scopeNote           "A collections manager is a type of conservator specifically associated with a museum collection"@en ;
    skos:notation            "conservator" ;
    dcterms:identifier       "conservator" ;
    dcterms:source           "ISO 5127:2017(en) Information and documentation — Foundation and vocabulary" ;
    rdfs:seeAlso             <https://www.iso.org/standard/59743.html> ;

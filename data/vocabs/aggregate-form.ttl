.

<https://kos.resources.org/def/aggregate-form/concentric>
    a                        skos:Concept ;
    skos:prefLabel           "Concentric"@en ;
    skos:prefLabel           "konzentrisch"@de ;
    skos:definition          """Minerals grew in distinct bands around a center as in malachite or agate. Often the bands consist of parallel oriented fibres like in cut botryoidal hematite aggregate."""@en ;
    skos:inScheme            <https://kos.resources.org/def/aggregate-form> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:topConceptOf        <https://kos.resources.org/def/aggregate-form> ;
    skos:notation            "concentric" ;
.


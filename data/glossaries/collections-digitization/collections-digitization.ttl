    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-capture>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Data Capture"@en ;
    skos:definition          """Deliberate action that results in the registration of a record into a record keeping system."""@en ;
    skos:notation            "data-capture" ;
    dcterms:identifier       "data-capture" ;
    dcterms:source           "ISO 18530:2021 Health informatics — Automatic identification and data capture marking and labelling — Subject of care and individual provider identification" ;

# ============================================================================
# ConceptScheme
# ============================================================================

<https://kos.geospecimens.org/def/kos-meta>
    a                        skos:ConceptScheme ;
    dcterms:title            "Knowledge Organization System Resources Metadata Vocabulary"@en ;
    dcterms:description      """A metadata concept scheme for describing knowledge organization system resources published via the KOS Geospecimens Platform and Registry"""@en ;
    dcterms:publisher        <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:creator          <https://kos.geospecimens.org/org/ben-norton> ;
    dcterms:created          "2026-09-11"^^xsd:date ;
    dcterms:modified         "2026-09-11"^^xsd:date ;
    dcat:version             "2026-09-11" ;
    skos:scopeNote           "Terms apply to KOS resources such as glossaries and concept schemes"@en ;
    vann:usageNote           "The terms in this vocabulary are intended to supplement the annotation scheme constructed from existing vocabularies such as skos and dcterms"@en ;
    schema:citation          "Norton B (2026) Knowledge Organization System Resource Metadata Vocabulary (pending)"@en ;
    schema:license           <https://creativecommons.org/licenses/by/4.0/> ;
    reg:derivationMode       <https://linked.data.gov.au/def/vocdermods/none> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/submitted> ;
    skos:hasTopConcept       <https://kos.geospecimens.org/def/kos-meta/is-material-aggregate> ;
    prov:qualifiedAttribution [
        a                prov:Attribution ;
        prov:agent       <https://kos.geospecimens.org/org/ben-norton> ;
        dcat:hadRole     isoroles:publisher , isoroles:author , isoroles:custodian ;
    ] ;
.

# ============================================================================
# Concepts
# ============================================================================

<https://kos.geospecimens.org/def/kos-meta/is-material-aggregate>
    a                        skos:Concept ;
    skos:prefLabel           "Is Material Aggregate"@en ;
    skos:altLabel            "Is Aggregate"@en ,
                             "Is Compound Material"@en ;
    skos:definition          """An indication of whether the materials denoted by a material category are composed of constituent materials belonging to one or more other material categories."""@en ;
    vann:usageNote           "The property applies to the material category, not to individual specimens. Recommended values are true and false (xsd:boolean). A value of true asserts compositional aggregation only — it does not identify which categories the constituents belong to, and it is distinct from hierarchical (broader/narrower) relationships between categories within the scheme."@en ;
    skos:inScheme            <https://kos.geospecimens.org/def/kos-meta> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    skos:topConceptOf        <https://kos.geospecimens.org/def/kos-meta> ;
    skos:notation            "isMaterialAggregate" ;
.


    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/identifier>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Identifier"@en ;
    skos:definition          """A word, number, letter, symbol, or any combination of these used to uniquely identify or reference an individual instance of an entity within a specific information domain."""@en ;
    skos:scopeNote           "Can include Global Persistent Identifiers (globally unique and persistently resolvable identifier for the entity) and/or Local Identifiers. Both the domain within which the identifier is unique, and the rules used in forming the identifier value should be provided with the identifier value."@en ;
    skos:notation            "identifier" ;
    dcterms:identifier       "identifier" ;
    dcterms:source           "International Council on Archives Records in Contexts Ontology (ICA RiC-O) version 1.1" ;
    rdfs:seeAlso             <https://www.ica.org/standards/RiC/ontology#Identifier> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/identifier-assignment>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Identifier assignment"@en ;
    skos:definition          """An activity that results in the allocation of an identifier that may be locally or globally unique"""@en ;
    skos:scopeNote           "Documenting the act of identifier assignment and deassignment is especially useful when objects change custody or the identification system of an organization is changed."@en ;
    skos:notation            "identifier-assignment" ;
    dcterms:identifier       "identifier-assignment" ;
    dcterms:source           "CIDOC Conceptual Reference Model version 7.1.3" ;
    rdfs:seeAlso             <http://www.cidoc-crm.org/cidoc-crm/E15_Identifier_Assignment> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/initiator>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Initiator"@en ;
    skos:definition          """Something that sets into motion some course of events or causes something to happen."""@en ;
    skos:scopeNote           "In the context of a collection workflow, an initiator starts a new procedure or branch of an existing workflow"@en ;
    skos:notation            "initiator" ;
    dcterms:identifier       "initiator" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/NCIT_C54190> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/igsn>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "International Generic Sample Number"@en ;
    skos:definition          """Globally unique, persistent and domain-agnostic identifiers for physical samples resolved through a Handle System. Mirrors the format and usage of DOIs Notation: IGSN"""@en ;
    skos:example             "10.58151/NHB000N08"@en ;
    skos:notation            "igsn" ;
    dcterms:identifier       "igsn" ;
    dcterms:source           "https://ev.igsn.org/" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/iri>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Internationalized Resource Identifier"@en ;
    skos:definition          """An internet protocol standard which builds on the Uniform Resource Identifier (URI) protocol by greatly expanding the set of permitted characters. Notation: IRI"""@en ;
    skos:example             "http://rs.tdwg.org/dwc/iri/preparations"@en ;
    skos:notation            "iri" ;
    dcterms:identifier       "iri" ;
    dcterms:source           "RFC 3987" ;
    rdfs:seeAlso             <https://datatracker.ietf.org/doc/rfc3987/> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/iterative-workflow>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Iterative Workflow"@en ;
    skos:definition          """A workflow whose steps are the repetition of the same task type."""@en ;
    skos:notation            "iterative-workflow" ;
    dcterms:identifier       "iterative-workflow" ;
    dcterms:source           "Elementary Multiperspective Material Ontology" ;
    rdfs:seeAlso             <https://w3id.org/emmo#EMMO_ddecfff6_d3a1_4972_b9e9_3d0ca11a3a0b> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/kind-of>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Kind (of)"@en ;
    skos:definition          """A grouping of entities that share a common set of characteristics in a particular context."""@en ;
    skos:scopeNote           "Analogous to a 'category' or classification scheme item value"@en ;
    skos:notation            "kind-of" ;
    dcterms:identifier       "kind-of" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/library>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Library"@en ;
    skos:definition          """Organization, or part of an organization, the main aim of which is to facilitate the use of such information resources, services and facilities as are required to meet the informational, research, educational, cultural or recreational needs of its users"""@en ;
    skos:notation            "library" ;
    dcterms:identifier       "library" ;
    dcterms:source           "ISO 18461:2016 International museum statistics" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/lsid>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Life Science Identifier"@en ;
    skos:definition          """A type of uniform resource name (URN) that conforms to the URN standards defined by the IETF. Notation: LSID"""@en ;
    skos:example             "http://www.lsid.info/urn:lsid:marinespecies.org:taxname:138474"@en ;
    skos:notation            "lsid" ;
    dcterms:identifier       "lsid" ;
    dcterms:source           "https://www.lsid.info/" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/loan>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Loan"@en ;
    skos:definition          """The temporary transfer of custody of museum property on either a short- term (three years or less) or long-term basis."""@en ;
    skos:scopeNote           "A loan must be for official purposes and may be incoming or outgoing. The terms of a loan are documented in a loan agreement or similar instrument."@en ;
    skos:notation            "loan" ;
    dcterms:identifier       "loan" ;
    dcterms:source           "Master Glossary for DOI Museum Property Directives" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/local-identifier>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Local Identifier"@en ;
    skos:definition          """Designates an assigned code that is uniquely and meaningfully defined only in the local source system or within the scope of an internal management system."""@en ;
    skos:scopeNote           "Locally defined identifiers should not be used to establish equality between resources from separate source systems. They may be used only to compare resources coming from the same local system. They must not be considered to have meaning of their own."@en ;
    skos:notation            "local-identifier" ;
    dcterms:identifier       "local-identifier" ;
    dcterms:source           "Lightweight Information Describing Objects" ;
    rdfs:seeAlso             <http://terminology.lido-schema.org/lido00100> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/man-made-object>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Man-made Object"@en ;
    skos:definition          """Comprises all persistent physical objects of any size that are purposely created by human activity and have physical boundaries that separate them completely in an objective way from other objects."""@en ;
    skos:scopeNote           "Includes all aggregates of objects made for functional purposes of whatever kind, independent of physical coherence, such as a set of chessmen."@en ;
    skos:notation            "man-made-object" ;
    dcterms:identifier       "man-made-object" ;
    dcterms:source           "CIDOC Conceptual Reference Model version 7.1.3" ;
    rdfs:seeAlso             <https://cidoc-crm.org/sites/default/files/cidoc_crm_version_7.1.3.pdf> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/material-entity>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Material Entity"@en ;
    skos:definition          """An entity that exists in full during the length of time of its existence, persists through this time while maintaining its identity and has no temporal parts."""@en ;
    skos:notation            "material-entity" ;
    dcterms:identifier       "material-entity" ;
    dcterms:source           "Basic Form Ontology" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/BFO_0000040> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/material-sample>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Material Sample"@en ;
    skos:definition          """A material entity that represents an entity of interest in whole or in part dwc:MaterialSample. Top concept in material sample object type hierarchy. Represents any material sample object."""@en ;
    skos:notation            "material-sample" ;
    dcterms:identifier       "material-sample" ;
    dcterms:source           "Darwin Core" ;
    rdfs:seeAlso             <http://rs.tdwg.org/dwc/terms/MaterialSample> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/metadata>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Metadata"@en ;
    skos:definition          """Data that defines and describes other data"""@en ;
    skos:notation            "metadata" ;
    dcterms:identifier       "metadata" ;
    dcterms:source           "ISO/IEC 5207:2024(en) Information technology — Data usage — Terminology and use cases" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/mobilization>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Mobilization"@en ;
    skos:definition          """The process of preparing and transferring data from an internal resource or system to external networks for the purposes of distribution"""@en ;
    skos:notation            "mobilization" ;
    dcterms:identifier       "mobilization" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/module>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Module"@en ;
    skos:definition          """A self-contained component (unit or item) that is used in combination with other components."""@en ;
    skos:notation            "module" ;
    dcterms:identifier       "module" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/NCIT_C42721> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/museum>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Museum"@en ;
    skos:definition          """An institution that cares for (conserves) a collection of artifacts and other objects of scientific, artistic, cultural, or historical importance."""@en ;
    skos:notation            "museum" ;
    dcterms:identifier       "museum" ;
    dcterms:source           "The Biological Collections Ontology" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/BCO_0000059> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/museum-collection>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Museum Collection"@en ;
    skos:definition          """An object aggregate that has as member parts a material sample that is located in a museum as a result of a process of curation."""@en ;
    skos:scopeNote           "The class museum collection has meaning that is much broader than biological collections. It would probably be better to import this term from another, more general ontology and create a specific subclass for natural history museum collection."@en ;
    skos:notation            "museum-collection" ;
    dcterms:identifier       "museum-collection" ;
    dcterms:source           "The Biological Collections Ontology" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/BCO_0000031> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/natural-sciences>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Natural Sciences"@en ;
    skos:definition          """The natural sciences are those branches of empirical science that produce a comprehension of the natural world through the use of data collected from it by observation and measurement to construct deterministic and/or stochastic quantitative models of its phenomena."""@en ;
    skos:notation            "natural-sciences" ;
    dcterms:identifier       "natural-sciences" ;
    dcterms:source           "Modern Science Ontology" ;
    rdfs:seeAlso             <https://w3id.org/skgo/modsci#NaturalScience> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/online-collection>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Online Collection"@en ;
    skos:definition          """A virtual collection primarily designed and collocated for online presentation. The items presented in an online collection may refer to physical objects or digital resources, or both."""@en ;
    skos:notation            "online-collection" ;
    dcterms:identifier       "online-collection" ;
    dcterms:source           "Lightweight Information Describing Objects" ;
    rdfs:seeAlso             <http://terminology.lido-schema.org/lido01055> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/orcid>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Open Researcher and Contributor ID"@en ;
    skos:definition          """A unique, persistent identifier (PID) for individuals to use as they engage in research, scholarship, and innovation activities. Notation: ORCiD"""@en ;
    skos:example             "https://orcid.org/0000-0002-5819-9134"@en ;
    skos:notation            "orcid" ;
    dcterms:identifier       "orcid" ;
    dcterms:source           "https://orcid.org/" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/organization>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Organization"@en ;
    skos:definition          """An organization is a social or legal institution such as a company, society, etc."""@en ;
    skos:notation            "organization" ;
    dcterms:identifier       "organization" ;
    dcterms:source           "PROV-O: The PROV Ontology" ;
    rdfs:seeAlso             <http://www.w3.org/ns/prov#Organization> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/paleontology>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Paleontology"@en ;
    skos:definition          """Study of life in past geologic time based on fossil plants and animals."""@en ;
    skos:notation            "paleontology" ;
    dcterms:identifier       "paleontology" ;
    dcterms:source           "USGS Thesaurus" ;
    rdfs:seeAlso             <https://apps.usgs.gov/thesaurus/USGSThesaurus/paleontology> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/paleontology-collection>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Paleontology Collection"@en ;
    skos:definition          """A museum collection comprised predominantly of fossils"""@en ;
    skos:notation            "paleontology-collection" ;
    dcterms:identifier       "paleontology-collection" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/parallel-workflow>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Parallel Workflow"@en ;
    skos:definition          """A workflow with some tasks running concurrently."""@en ;
    skos:scopeNote           "A workflow can be seen as a direct acyclic graph, whose nodes are tasks and edges are asymmetric causal relations. A parallel graph occurs when the topological order of such graph if not unique, meaning that there is at least one portion of the workflow in which at least two tasks are running concurrently."@en ;
    skos:notation            "parallel-workflow" ;
    dcterms:identifier       "parallel-workflow" ;
    dcterms:source           "Elementary Multiperspective Material Ontology" ;
    rdfs:seeAlso             <https://w3id.org/emmo#EMMO_5848e476_2768_4988_98f9_9053c532307b> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/pid>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Persistent Identifier"@en ;
    skos:definition          """Unique identifier that ensures permanent access for a digital object by providing access to it independently of its physical location or current ownership. PID are a generalized reference and not specific to a particular standardized format such as a UUID Notation: PID"""@en ;
    skos:example             "https://orcid.org/0000-0002-5819-9134"@en ;
    skos:notation            "pid" ;
    dcterms:identifier       "pid" ;
    dcterms:source           "ISO 5127:2017(en) Information and documentation — Foundation and vocabulary" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/physical-collection>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Physical Collection"@en ;
    skos:definition          """Designates an aggregated group of tangible objects"""@en ;
    skos:scopeNote           "Disambiguates Collection terms in the LIDO ObjectType vocabulary. Here, Physical Collections are disambiguated from Digital and Online Collections"@en ;
    skos:notation            "physical-collection" ;
    dcterms:identifier       "physical-collection" ;
    dcterms:source           "Adopted from http://terminology.lido-schema.org/lido01053" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/physical-object>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Physical Object"@en ;
    skos:definition          """Items of a material nature that are units for documentation and have physical boundaries that separate them completely in an objective way from other objects."""@en ;
    skos:scopeNote           "The decision as to what is documented as a complete item, rather than by its parts or components, may be purely administrative or may be a result of the order in which the item was acquired."@en ;
    skos:example             "Information about the Principal Investigator who recorded the data, and the information concerning its storage, handling, and migration."@en ;
    skos:notation            "physical-object" ;
    dcterms:identifier       "physical-object" ;
    dcterms:source           "CIDOC Conceptual Reference Model version 7.1.3" ;
    rdfs:seeAlso             <http://www.cidoc-crm.org/cidoc-crm/E19_Physical_Object> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/pipeline>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Pipeline"@en ;
    skos:definition          """Full set of logically connected steps needed to transform input data into a result, for which one or more outputs of one data transformation step can be the input of one or more subsequent steps"""@en ;
    skos:notation            "pipeline" ;
    dcterms:identifier       "pipeline" ;
    dcterms:source           "ISO/IEC 11179-34:2024(en) Information technology — Metadata registries (MDR) — Part 34: Metamodel for computable data registration" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/plan>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Plan"@en ;
    skos:definition          """An entity that represents a set of intended actions or steps executed by one or more agents to achieve some goals."""@en ;
    skos:notation            "plan" ;
    dcterms:identifier       "plan" ;
    dcterms:source           "PROV-O: The PROV Ontology" ;
    rdfs:seeAlso             <http://www.w3.org/ns/prov#Plan> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/plan-specification>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Plan specification"@en ;
    skos:definition          """A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified."""@en ;
    skos:notation            "plan-specification" ;
    dcterms:identifier       "plan-specification" ;
    dcterms:source           "Information Artifact Ontology" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/IAO_0000104> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/planned-process>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Planned process"@en ;
    skos:definition          """A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification."""@en ;
    skos:notation            "planned-process" ;
    dcterms:identifier       "planned-process" ;
    dcterms:source           "Core Ontology for Biology and Biomedicine" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/COB_0000082> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/preparation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Preparation"@en ;
    skos:definition          """Activities, taking place after specimen acquisition, to make material suitable for a specific purpose such as laboratory (tissue) analysis or long-term preservation"""@en ;
    skos:scopeNote           "The term and associated definition are strictly within the scope of a museum collection and not intended for wider application."@en ;
    skos:notation            "preparation" ;
    dcterms:identifier       "preparation" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/preparator>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Preparator"@en ;
    skos:definition          """Person carrying out the operations required for the conservation of dead animals for decoration purposes or for scientific study"""@en ;
    skos:notation            "preparator" ;
    dcterms:identifier       "preparator" ;
    dcterms:source           "ISO 5127:2017(en) Information and documentation — Foundation and vocabulary" ;
    rdfs:seeAlso             <https://www.iso.org/standard/59743.html> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/preservation>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Preservation"@en ;
    skos:definition          """Act to prevent or impede biological or physical deterioration of biological material"""@en ;
    skos:scopeNote           "The term and associated definition are strictly within the scope of a biological collection and biological material."@en ;
    skos:notation            "preservation" ;
    dcterms:identifier       "preservation" ;
    dcterms:source           "This Document" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/primary-source>
    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Primary Source"@en ;
    skos:definition          """Materials that provide first-hand documentation or knowledge, usually of people, places, events or time periods."""@en ;
    skos:scopeNote           "Primary sources enable the researcher to trace a research subject to its origin, potentially supporting new interpretations or revealing previously undocumented knowledge of that subject. Secondary sources build upon or extrapolate information derived from primary sources, and the distinction between the two can be quite fluid depending on one's area of study. In most contexts, however, a primary source is understood to be a point of origin, or a piece of raw data, for a research subject."@en ;
    skos:notation            "primary-source" ;
    dcterms:identifier       "primary-source" ;
    dcterms:source           "SDSU Library Guides" ;
    rdfs:seeAlso             <https://libguides.sdsu.edu/primary-sources/terms> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/procedure>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Procedure"@en ;
    skos:definition          """An intentional planned process performed by an agent within the context of a workflow"""@en ;
    skos:scopeNote           "An intentional process in which an agent works with some entities according to some existing formalised operative rules."@en ;
    skos:notation            "procedure" ;
    dcterms:identifier       "procedure" ;
    dcterms:source           "Elementary Multiperspective Material Ontology" ;
    rdfs:seeAlso             <https://w3id.org/emmo#EMMO_472a0ca2_58bf_4618_b561_6fe68bd9fd49> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/procedure-specification>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Procedure Specification"@en ;
    skos:definition          """A specification on the order, transitions and trigger of multiple action specifications that are part of some aggregate action specification."""@en ;
    skos:notation            "procedure-specification" ;
    dcterms:identifier       "procedure-specification" ;
    dcterms:source           "Allotrope Foundation Ontology" ;
    rdfs:seeAlso             <http://purl.allotrope.org/ontologies/result#AFR_0000938> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/process>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Process"@en ;
    skos:definition          """A coordinated (parallel and/or serial) sequence of tasks that are connected in order to achieve a common goal as part of a workflow"""@en ;
    skos:notation            "process" ;
    dcterms:identifier       "process" ;
    dcterms:source           "Adopted from ISO 12651-2:2014 and https://www.irit.fr/recherches/MELODI/ontologies/BBO#Process" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/process-protocol>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Process Protocol"@en ;
    skos:definition          """A standard operating procedure (SOP) that is a collection of activities and the rules that describe when each activity is performed to achieve a specific purpose or objective(s)."""@en ;
    skos:notation            "process-protocol" ;
    dcterms:identifier       "process-protocol" ;
    dcterms:source           "NCI Thesaurus OBO Edition" ;
    rdfs:seeAlso             <http://purl.obolibrary.org/obo/NCIT_C164368> ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/project>
    a                        skos:Concept , prov:Activity ;
    skos:prefLabel           "Project"@en ;
    skos:definition          """A temporary endeavor undertaken to achieve defined objectives"""@en ;
    skos:notation            "project" ;
    dcterms:identifier       "project" ;
    dcterms:source           "ISO 21506:2024  Project, programme and portfolio management — Vocabulary" ;

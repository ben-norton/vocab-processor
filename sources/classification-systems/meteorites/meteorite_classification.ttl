@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix mc:   <https://kos.geospecimens.org/def/meteorite-classification/> .
@prefix mcs:  <https://kos.geospecimens.org/def/meteorite-classification/source/> .
@prefix mcp:  <https://kos.geospecimens.org/def/meteorite-classification/prop/> .

mcp:rank a rdf:Property ;
    rdfs:label "rank"@en ;
    rdfs:comment "Position of the concept in the Weisberg et al. (2006) hierarchy: root, division, class, clan, group, or subgroup."@en .

mc:scheme a skos:ConceptScheme ;
    dct:title "Meteorite Classification (Weisberg, McCoy & Krot 2006)"@en ;
    dct:description "SKOS rendering of the meteorite classification systematics of Weisberg et al. (2006), Fig. 1, covering divisions, classes, clans, groups, and subgroups."@en ;
    dct:created "2026-06-03"^^xsd:date ;
    dct:source mcs:weisberg2006 , mcs:scottwasson1975 , mcs:wassonironseries , mcs:wassonkallemeyn2002 , mcs:lunarlit ;
    skos:hasTopConcept mc:MC_0001 .

mcs:weisberg2006 a dct:BibliographicResource ;
    rdfs:label "Weisberg et al. (2006)"@en ;
    dct:bibliographicCitation "Weisberg M. K., McCoy T. J., and Krot A. N. (2006) Systematics and Evaluation of Meteorite Classification. In Meteorites and the Early Solar System II (D. S. Lauretta and H. Y. McSween Jr., eds.), pp. 19-52. University of Arizona Press, Tucson."@en
    ;
    dct:identifier "ISBN:9780816525621" .

mcs:scottwasson1975 a dct:BibliographicResource ;
    rdfs:label "Scott & Wasson (1975)"@en ;
    dct:bibliographicCitation "Scott E. R. D. and Wasson J. T. (1975) Classification and properties of iron meteorites. Reviews of Geophysics and Space Physics, 13(4), 527-546."@en
    ;
    dct:identifier "doi:10.1029/RG013i004p00527" ;
    rdfs:seeAlso <https://doi.org/10.1029/RG013i004p00527> .

mcs:wassonironseries a dct:BibliographicResource ;
    rdfs:label "Wasson iron-classification series"@en ;
    dct:bibliographicCitation "Wasson J. T. and coworkers (1967-1976) 'The chemical classification of iron meteorites' (multi-part series), Geochimica et Cosmochimica Acta; e.g. Wasson J. T. and Kimberlin J. (1967) Part II, GCA 31, 149-178."@en .

mcs:wassonkallemeyn2002 a dct:BibliographicResource ;
    rdfs:label "Wasson & Kallemeyn (2002)"@en ;
    dct:bibliographicCitation "Wasson J. T. and Kallemeyn G. W. (2002) The IAB iron-meteorite complex: A group, five subgroups, numerous grouplets, closely related, mainly formed by crystal segregation in rapidly cooling melts. Geochimica et Cosmochimica Acta, 66(13), 2445-2473."@en .

mcs:lunarlit a dct:BibliographicResource ;
    rdfs:label "lunar meteorite literature (Korotev; Lunar Meteorite Compendium)"@en ;
    dct:bibliographicCitation "Korotev R. L. (2005) Lunar geochemistry as told by lunar meteorites. Chemie der Erde - Geochemistry, 65(4), 297-346; and Lunar Meteorite Compendium (Righter K., compiler), NASA Johnson Space Center."@en
    ;
    rdfs:seeAlso <https://curator.jsc.nasa.gov/antmet/lmc/> .

mc:MC_0001 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Meteorites"@en ;
    skos:notation "Meteorites" ;
    mcp:rank "root" ;
    skos:definition "Solid extraterrestrial fragments that survive atmospheric passage; classified by mineralogy, petrography, bulk chemistry and O-isotopes into chondrites, primitive achondrites and achondrites."@en ;
    dct:source mcs:weisberg2006 ;
    skos:topConceptOf mc:scheme ;
    skos:narrower mc:MC_0002 , mc:MC_0003 , mc:MC_0004 .

mc:MC_0002 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Chondrites"@en ;
    skos:notation "Chondrites" ;
    mcp:rank "division" ;
    skos:definition "Undifferentiated meteorites with broadly solar (CI-like) bulk compositions minus the most volatile elements, from bodies that never underwent planetary melting; most contain chondrules. 15 groups across the C, O and E classes plus R and K."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0001 ;
    skos:narrower mc:MC_0005 , mc:MC_0006 , mc:MC_0007 , mc:MC_0032 , mc:MC_0033 .

mc:MC_0003 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Primitive achondrites"@en ;
    skos:notation "Primitive Achondrites" ;
    mcp:rank "division" ;
    skos:definition "Nonchondritic meteorites with igneous or recrystallized textures that retain a chemical/isotopic affinity to chondritic precursors; interpreted as residues or low-degree partial melts that did not fully differentiate."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0001 ;
    skos:narrower mc:MC_0034 , mc:MC_0035 , mc:MC_0036 , mc:MC_0039 .

mc:MC_0004 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Achondrites"@en ;
    skos:notation "Achondrites" ;
    mcp:rank "division" ;
    skos:definition "Differentiated meteorites - igneous rocks, melt residues, or breccias of igneous fragments - from asteroids, Mars and the Moon that experienced a high degree of melting; includes stones, stony-irons and irons."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0001 ;
    skos:narrower mc:MC_0043 , mc:MC_0044 , mc:MC_0045 , mc:MC_0046 , mc:MC_0050 , mc:MC_0054 , mc:MC_0065 , mc:MC_0066 .

mc:MC_0005 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Carbonaceous chondrites"@en ;
    skos:notation "C" ;
    mcp:rank "class" ;
    skos:definition "Chondrite class with Mg-normalized refractory-lithophile abundances at or above CI and O-isotopes plotting near or below the terrestrial fractionation line; eight groups."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0002 ;
    skos:narrower mc:MC_0008 , mc:MC_0009 , mc:MC_0010 , mc:MC_0011 .

mc:MC_0006 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Ordinary chondrites"@en ;
    skos:notation "O" ;
    mcp:rank "class" ;
    skos:definition "The most abundant chondrites (>85% of falls); abundant large chondrules, low matrix, refractory-lithophile abundances below CI, O-isotopes above the TF line. The three groups form one clan."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0002 ;
    skos:narrower mc:MC_0025 .

mc:MC_0007 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Enstatite chondrites"@en ;
    skos:notation "E" ;
    mcp:rank "class" ;
    skos:definition "Chondrites formed under highly reducing conditions, with Fe-poor silicates, Si-bearing metal and unusual sulfides/nitrides; O-isotopes on the TF line near Earth and the Moon. Two groups."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0002 ;
    skos:narrower mc:MC_0029 .

mc:MC_0008 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CI clan"@en ;
    skos:notation "CI" ;
    mcp:rank "clan" ;
    skos:definition "Single-group clan; CI chondrites show nothing linking them to the other carbonaceous clans."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0005 ;
    skos:narrower mc:MC_0012 .

mc:MC_0009 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CM-CO clan"@en ;
    skos:notation "CM-CO" ;
    mcp:rank "clan" ;
    skos:definition "Clan linking the CM and CO groups by similar chondrule sizes, refractory-lithophile abundances, and high-temperature-mineral O-isotopes."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0005 ;
    skos:narrower mc:MC_0013 , mc:MC_0014 .

mc:MC_0010 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CV-CK clan"@en ;
    skos:notation "CV-CK" ;
    mcp:rank "clan" ;
    skos:definition "Clan grouping CV and CK chondrites, which share overlapping CCAM-line O-isotopes and magnetite chemistry; low-type CK resembles oxidized CV."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0005 ;
    skos:narrower mc:MC_0015 , mc:MC_0016 .

mc:MC_0011 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CR clan"@en ;
    skos:notation "CR" ;
    mcp:rank "clan" ;
    skos:definition "Clan of the metal-rich CR, CH and CB groups (plus ungrouped LEW 85332), united by solar-Ni/Co metal, strong volatile-lithophile depletions, CR-line O-isotopes, and large d15N anomalies."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0005 ;
    skos:narrower mc:MC_0017 , mc:MC_0018 , mc:MC_0019 .

mc:MC_0012 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CI (Ivuna-type)"@en ;
    skos:notation "CI" ;
    mcp:rank "group" ;
    skos:definition "Ivuna-type; among the most primitive solar-system materials, bulk composition close to the solar photosphere. All petrologic type 1: heavily hydrated, brecciated, chondrule- and CAI-free phyllosilicate-rich rocks."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0008 .

mc:MC_0013 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CM (Mighei-type)"@en ;
    skos:notation "CM" ;
    mcp:rank "group" ;
    skos:definition "Mighei-type; the most abundant C chondrites. Small (~300 um) chondrules, abundant matrix, CAIs/AOAs partly replaced by phyllosilicates; mostly aqueously altered type 2 (some type 1)."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0009 .

mc:MC_0014 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CO (Ornans-type)"@en ;
    skos:notation "CO" ;
    mcp:rank "group" ;
    skos:definition "Ornans-type; small (~150 um) chondrules with 30-45 vol% matrix; petrologic types 3.0-3.7, O-isotopes on the CCAM line overlapping CV."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0009 .

mc:MC_0015 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CV (Vigarano-type)"@en ;
    skos:notation "CV" ;
    mcp:rank "group" ;
    skos:definition "Vigarano-type; abundant matrix, large (~1 mm) chondrules and abundant large CAIs/AOAs; all type 3, divided into oxidized and reduced subgroups."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0010 ;
    skos:narrower mc:MC_0020 , mc:MC_0021 , mc:MC_0022 .

mc:MC_0016 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CK (Karoonda-type)"@en ;
    skos:notation "CK" ;
    mcp:rank "group" ;
    skos:definition "Karoonda-type; matrix-rich with large (700-1000 um) porphyritic chondrules; highly oxidized (fayalitic olivine, abundant magnetite), mostly high petrologic type 4-6."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0010 .

mc:MC_0017 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CR (Renazzo-type)"@en ;
    skos:notation "CR" ;
    mcp:rank "group" ;
    skos:definition "Renazzo-type; mostly type 2, with large metal-rich porphyritic Mg-rich chondrules with multilayered rims, hydrated matrix, solar-Ni/Co metal, and large d15N."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0011 .

mc:MC_0018 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CH (high-metal)"@en ;
    skos:notation "CH" ;
    mcp:rank "group" ;
    skos:definition "ALH 85085-type; high metal (~20 vol%), tiny (<100 um) mostly cryptocrystalline chondrules, virtually no matrix, very large d15N anomalies."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0011 .

mc:MC_0019 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CB (Bencubbin-type)"@en ;
    skos:notation "CB" ;
    mcp:rank "group" ;
    skos:definition "Bencubbin-type; extreme metal (60-80 vol%), cryptocrystalline/barred chondrules, strong volatile-lithophile depletion and heavy-N enrichment; subgroups CBa and CBb."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0011 ;
    skos:narrower mc:MC_0023 , mc:MC_0024 .

mc:MC_0020 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CV subgroup A (oxidized, Allende-like)"@en ;
    skos:notation "CV_A" ;
    mcp:rank "subgroup" ;
    skos:definition "Oxidized Allende-like CV (CVoxA); secondary ferrous olivine, Ca,Fe-pyroxene, andradite and nepheline/sodalite, coarser matrix than CVoxB with only minor phyllosilicates."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0015 .

mc:MC_0021 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CV subgroup B (oxidized, Bali-like)"@en ;
    skos:notation "CV_B" ;
    mcp:rank "subgroup" ;
    skos:definition "Oxidized Bali-like CV (CVoxB); aqueously altered with abundant phyllosilicates, magnetite, fayalite and Ca,Fe-pyroxenes; highest matrix/chondrule ratio."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0015 .

mc:MC_0022 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CV subgroup (reduced)"@en ;
    skos:notation "CV_red" ;
    mcp:rank "subgroup" ;
    skos:definition "Reduced CV (CVred); lowest matrix/chondrule and highest metal/magnetite ratios, with only minor nepheline/sodalite and Ca,Fe-pyroxenes."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0015 .

mc:MC_0023 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CB subgroup a"@en ;
    skos:notation "CB_a" ;
    mcp:rank "subgroup" ;
    skos:definition "CBa; ~60 vol% metal, centimeter-sized chondrules, metal with 5-8 wt% Ni, d15N up to ~1000 per mil."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0019 .

mc:MC_0024 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "CB subgroup b"@en ;
    skos:notation "CB_b" ;
    mcp:rank "subgroup" ;
    skos:definition "CBb; >70 vol% metal, millimeter-sized chondrules, metal with 4-15 wt% Ni, d15N ~200 per mil; argued to be the more primitive nebular endmember."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0019 .

mc:MC_0025 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "H-L-LL clan"@en ;
    skos:notation "H-L-LL" ;
    mcp:rank "clan" ;
    skos:definition "Single ordinary-chondrite clan; H, L and LL overlap in O-isotopes and petrology, indicating close kinship."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0006 ;
    skos:narrower mc:MC_0026 , mc:MC_0027 , mc:MC_0028 .

mc:MC_0026 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "H (high iron)"@en ;
    skos:notation "H" ;
    mcp:rank "group" ;
    skos:definition "Highest total Fe and metallic-Fe/FeO ratio among O chondrites; equilibrated olivine Fa16-20."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0025 .

mc:MC_0027 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "L (low iron)"@en ;
    skos:notation "L" ;
    mcp:rank "group" ;
    skos:definition "Intermediate Fe content among O chondrites; equilibrated olivine Fa23-26."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0025 .

mc:MC_0028 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "LL (low iron, low metal)"@en ;
    skos:notation "LL" ;
    mcp:rank "group" ;
    skos:definition "Lowest Fe and metal among O chondrites; equilibrated olivine Fa27-32."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0025 .

mc:MC_0029 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "EH-EL clan"@en ;
    skos:notation "EH-EL" ;
    mcp:rank "clan" ;
    skos:definition "Single enstatite-chondrite clan; EH and EL are distinguished mainly by sulfide chemistry and metal Si content."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0007 ;
    skos:narrower mc:MC_0030 , mc:MC_0031 .

mc:MC_0030 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "EH (high iron)"@en ;
    skos:notation "EH" ;
    mcp:rank "group" ;
    skos:definition "High-Fe enstatite chondrites; more reduced, niningerite-bearing, with Si-rich (2-3 wt%) metal."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0029 .

mc:MC_0031 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "EL (low iron)"@en ;
    skos:notation "EL" ;
    mcp:rank "group" ;
    skos:definition "Low-Fe enstatite chondrites; alabandite-bearing, <1 wt% Si in metal, ranging to higher petrologic types (EL6)."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0029 .

mc:MC_0032 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "R (Rumuruti-type)"@en ;
    skos:notation "R" ;
    mcp:rank "group" ;
    skos:definition "Rumuruti-type; highly oxidized, FeO-rich olivine (Fa37-40), nearly metal-free, ~50% matrix; highest delta-17O of any chondrite group; affiliated with but distinct from the O class (possibly a separate class or O clan)."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0002 .

mc:MC_0033 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "K (Kakangari-type)"@en ;
    skos:notation "K" ;
    mcp:rank "group" ;
    skos:definition "Kakangari-type grouplet; chemically, mineralogically and isotopically distinct from the C, O and E classes; high matrix, Fe-poor olivine/enstatite, O-isotopes below the TF line; a candidate first member of a fourth chondrite class."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0002 .

mc:MC_0034 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Ureilite"@en ;
    skos:notation "URE" ;
    mcp:rank "group" ;
    skos:definition "Ureilites; olivine-pyroxene rocks with interstitial graphite/diamond, metal and sulfides and reduced olivine rims; O-isotopes scatter along the CCAM line. Interpreted as partial-melt residues / mantle rock of the ureilite parent body."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0003 .

mc:MC_0035 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Brachinite"@en ;
    skos:notation "BRA" ;
    mcp:rank "group" ;
    skos:definition "Brachinites; medium- to coarse-grained, olivine-rich (74-98%) equigranular achondrites with near-chondritic lithophile abundances; debated origin as residues, cumulates, or recrystallized chondritic material."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0003 .

mc:MC_0036 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Acapulcoite-Lodranite clan"@en ;
    skos:notation "ACA-LOD" ;
    mcp:rank "clan" ;
    skos:definition "Acapulcoite-Lodranite clan; primitive achondrites with similar, spread O-isotopes; residues/products of low-degree partial melting of a chondritic precursor."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0003 ;
    skos:narrower mc:MC_0037 , mc:MC_0038 .

mc:MC_0037 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Acapulcoite"@en ;
    skos:notation "ACA" ;
    mcp:rank "group" ;
    skos:definition "Acapulcoites; fine-grained (150-230 um) equigranular rocks with near-chondritic mineral abundances and rare relict chondrules; formed by very low-degree partial melting (~950 C)."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0036 .

mc:MC_0038 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Lodranite"@en ;
    skos:notation "LOD" ;
    mcp:rank "group" ;
    skos:definition "Lodranites; coarse-grained (540-700 um) olivine-pyroxene rocks depleted in plagioclase and troilite; residues of higher-degree partial melting (~1250 C) with basaltic-melt removal."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0036 .

mc:MC_0039 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Winonaite-IAB-IIICD clan"@en ;
    skos:notation "WIN-IAB-IIICD" ;
    mcp:rank "clan" ;
    skos:definition "Winonaite-IAB-IIICD clan; silicate mineralogy and O-isotopes link winonaites to silicate inclusions in IAB (and possibly IIICD) irons, implying a shared or similar parent body."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0003 ;
    skos:narrower mc:MC_0040 , mc:MC_0041 , mc:MC_0042 .

mc:MC_0040 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Winonaite"@en ;
    skos:notation "WIN" ;
    mcp:rank "group" ;
    skos:definition "Winonaites; chondritic mineralogy/composition but recrystallized achondritic textures; mineral compositions between E and H chondrites, with Fe,Ni-FeS veins recording first partial melts."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0039 .

mc:MC_0041 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IAB iron (silicate-bearing)"@en ;
    skos:notation "IAB" ;
    mcp:rank "group" ;
    skos:definition "Silicate-bearing iron group whose inclusions resemble winonaites in mineralogy and O-isotopes; historically called 'nonmagmatic,' with textures suggesting impact mixing of metal and silicate. Wasson & Kallemeyn (2002) merge IAB+IIICD as the 'IAB complex.'"@en ;
    dct:source mcs:weisberg2006 , mcs:wassonkallemeyn2002 ;
    skos:broader mc:MC_0039 .

mc:MC_0042 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IIICD iron (silicate-bearing)"@en ;
    skos:notation "IIICD" ;
    mcp:rank "group" ;
    skos:definition "Silicate-bearing iron group historically paired with IAB; Wasson & Kallemeyn (2002) treat IAB+IIICD as a single IAB complex. Geochemical trends differ from the magmatic groups."@en ;
    dct:source mcs:weisberg2006 , mcs:wassonkallemeyn2002 ;
    skos:broader mc:MC_0039 .

mc:MC_0043 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Angrite"@en ;
    skos:notation "ANG" ;
    mcp:rank "group" ;
    skos:definition "Angrites; vesicular basaltic igneous rocks with unusual Ca-Al-Ti-rich pyroxene, Ca-rich olivine and anorthitic plagioclase - the most alkali-depleted basalts known; O-isotopes near HED but mineralogically distinct."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0004 .

mc:MC_0044 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Aubrite"@en ;
    skos:notation "AUB" ;
    mcp:rank "group" ;
    skos:definition "Aubrites (enstatite achondrites); highly reduced, brecciated rocks of nearly FeO-free enstatite with E-chondrite-like sulfides; likely linked to, but from a different parent body than, the EL chondrites."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0004 .

mc:MC_0045 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Mesosiderite (stony-iron)"@en ;
    skos:notation "MES" ;
    mcp:rank "group" ;
    skos:definition "Mesosiderites; stony-iron breccias of roughly equal silicate (basalt/gabbro/pyroxenite clasts) and Fe,Ni-metal+troilite, with metal intimately mixed with similarly sized silicate grains."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0004 .

mc:MC_0046 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "HED clan (Vesta?)"@en ;
    skos:notation "Vesta?" ;
    mcp:rank "clan" ;
    skos:definition "HED clan (howardites-eucrites-diogenites); basalts and orthopyroxene cumulates from a common asteroidal parent, sharing O-isotopes and pyroxene Fe/Mn; spectrally linked to asteroid 4 Vesta."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0004 ;
    skos:narrower mc:MC_0047 , mc:MC_0048 , mc:MC_0049 .

mc:MC_0047 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Eucrite"@en ;
    skos:notation "EUC" ;
    mcp:rank "group" ;
    skos:definition "Eucrites; basalts of plagioclase and clinopyroxene (pyroxene Fe/Mn ~30) from near-surface flows or intrusives; commonly brecciated."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0046 .

mc:MC_0048 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Diogenite"@en ;
    skos:notation "DIO" ;
    mcp:rank "group" ;
    skos:definition "Diogenites; coarse orthopyroxene cumulates from deeper plutonic levels of the HED parent body."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0046 .

mc:MC_0049 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Howardite"@en ;
    skos:notation "HOW" ;
    mcp:rank "group" ;
    skos:definition "Howardites; polymict regolith breccias mixing eucritic and diogenitic clasts."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0046 .

mc:MC_0050 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Pallasites (stony-iron)"@en ;
    skos:notation "PAL" ;
    mcp:rank "clan" ;
    skos:definition "Pallasites; olivine-metal (+troilite) stony-irons. 'Pallasite' is essentially a textural term: the main-group, Eagle Station and pyroxene pallasites (plus ungrouped Milton) formed on separate parent bodies and do not form a true clan/group."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0004 ;
    skos:narrower mc:MC_0051 , mc:MC_0052 , mc:MC_0053 .

mc:MC_0051 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Main-group pallasite"@en ;
    skos:notation "MG PAL" ;
    mcp:rank "group" ;
    skos:definition "Main-group pallasites; olivine-metal rocks whose metal resembles Ni-rich IIIAB irons and whose O-isotopes match the HEDs (no proven genetic link)."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0050 .

mc:MC_0052 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Eagle Station pallasite"@en ;
    skos:notation "ES PAL" ;
    mcp:rank "group" ;
    skos:definition "Eagle Station grouplet; more ferroan, Ca-rich olivine and distinct O-isotopes; metal resembles IIF irons (higher Ni and Ir)."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0050 .

mc:MC_0053 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Pyroxene pallasite"@en ;
    skos:notation "PP PAL" ;
    mcp:rank "group" ;
    skos:definition "Pyroxene-pallasite grouplet (e.g., Vermillion, Y-8451); contain mm-sized pyroxene, with metal and O-isotopes distinguishing them from the other pallasites."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0050 .

mc:MC_0054 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Irons"@en ;
    skos:notation "IRON" ;
    mcp:rank "clan" ;
    skos:definition "Iron meteorites; mostly cores of differentiated asteroids. The chemical classification (Scott & Wasson) uses Ga, Ge, Ir and Ni - a Roman numeral plus a letter - resolving 13 groups; ~10 are consistent with fractional crystallization in separate cores, and ~15% of irons (40% in Antarctica) are ungrouped."@en ;
    dct:source mcs:weisberg2006 , mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0004 ;
    skos:narrower mc:MC_0055 , mc:MC_0056 , mc:MC_0057 , mc:MC_0058 , mc:MC_0059 , mc:MC_0060 , mc:MC_0061 , mc:MC_0062 , mc:MC_0063 , mc:MC_0064 .

mc:MC_0055 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IC iron group"@en ;
    skos:notation "IC" ;
    mcp:rank "group" ;
    skos:definition "Magmatic iron group resolved on Ga/Ge-Ni plots; interpreted as a fractionally crystallized asteroid core."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0056 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IIAB iron group"@en ;
    skos:notation "IIAB" ;
    mcp:rank "group" ;
    skos:definition "Largest magmatic iron group (hexahedrites/coarse octahedrites); a fractional-crystallization trend from a single core."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0057 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IIC iron group"@en ;
    skos:notation "IIC" ;
    mcp:rank "group" ;
    skos:definition "Magmatic iron group with a traditional core-crystallization history."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0058 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IID iron group"@en ;
    skos:notation "IID" ;
    mcp:rank "group" ;
    skos:definition "Magmatic iron group formed by fractional crystallization in an asteroid core."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0059 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IIE iron group"@en ;
    skos:notation "IIE" ;
    mcp:rank "group" ;
    skos:definition "Silicate-bearing iron group; some silicates resemble H chondrites. Historically 'nonmagmatic,' with poorly defined elemental trends suggesting impact mixing of metal and silicate."@en ;
    dct:source mcs:weisberg2006 , mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0060 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IIIAB iron group"@en ;
    skos:notation "IIIAB" ;
    mcp:rank "group" ;
    skos:definition "One of the largest magmatic iron groups (octahedrites); a single fractional-crystallization sequence (former IIIA+IIIB), with metal close to main-group-pallasite composition."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0061 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IIIE iron group"@en ;
    skos:notation "IIIE" ;
    mcp:rank "group" ;
    skos:definition "Magmatic iron group resembling IIIA/IIIAB but resolved by lower Ga/Ni and Ge/Ni, larger kamacite bandwidths, and haxonite (carbide) in its members."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0062 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IIIF iron group"@en ;
    skos:notation "IIIF" ;
    mcp:rank "group" ;
    skos:definition "Small, volatile-depleted (low Ga/Ge) magmatic iron group, distinct from IIIAB."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0063 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IVA iron group"@en ;
    skos:notation "IVA" ;
    mcp:rank "group" ;
    skos:definition "Volatile-depleted magmatic iron group (fine octahedrites) with a range of cooling rates, suggesting metal pods at varying depths in a partially molten body."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0064 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "IVB iron group"@en ;
    skos:notation "IVB" ;
    mcp:rank "group" ;
    skos:definition "Most volatile-depleted iron group; metal matches a high-temperature (~1270 K) nebular condensate, implying high-temperature accretion."@en ;
    dct:source mcs:scottwasson1975 , mcs:wassonironseries ;
    skos:broader mc:MC_0054 .

mc:MC_0065 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Lunar (Moon)"@en ;
    skos:notation "Moon" ;
    mcp:rank "clan" ;
    skos:definition "Lunar meteorites; rocks launched from the Moon, sharing mineralogy/Fe-Mn and O-isotopes with Apollo/Luna samples but sampling random sites (including the farside). Mainly feldspathic-highland breccias, mare basalts/breccias, and mingled breccias."@en ;
    dct:source mcs:weisberg2006 , mcs:lunarlit ;
    skos:broader mc:MC_0004 .

mc:MC_0066 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Martian (SNC)"@en ;
    skos:notation "Mars" ;
    mcp:rank "clan" ;
    skos:definition "Martian (SNC) meteorites; crustal igneous rocks from Mars defining a unique slope-0.52 O-isotope line, with trapped gases matching the martian atmosphere. Includes shergottites, nakhlites, chassignites and orthopyroxenite ALH 84001."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0004 ;
    skos:narrower mc:MC_0067 , mc:MC_0068 , mc:MC_0069 , mc:MC_0070 .

mc:MC_0067 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Shergottite"@en ;
    skos:notation "SHE" ;
    mcp:rank "group" ;
    skos:definition "Shergottites; basaltic and lherzolitic/olivine-phyric volcanic-plutonic rocks, mostly young (<1.3 Ga); the most abundant martian meteorites."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0066 .

mc:MC_0068 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Nakhlite"@en ;
    skos:notation "NAK" ;
    mcp:rank "group" ;
    skos:definition "Nakhlites; clinopyroxene (augite)-rich cumulate rocks from Mars."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0066 .

mc:MC_0069 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Chassignite"@en ;
    skos:notation "CHA" ;
    mcp:rank "group" ;
    skos:definition "Chassignites; olivine-rich (dunitic) cumulate martian rocks (e.g., Chassigny)."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0066 .

mc:MC_0070 a skos:Concept ;
    skos:inScheme mc:scheme ;
    skos:prefLabel "Orthopyroxenite (ALH 84001)"@en ;
    skos:notation "OPX" ;
    mcp:rank "group" ;
    skos:definition "Orthopyroxenite represented by ALH 84001, a ~4.5 Ga coarse orthopyroxene cumulate from Mars, originally misclassified as a diogenite."@en ;
    dct:source mcs:weisberg2006 ;
    skos:broader mc:MC_0066 .

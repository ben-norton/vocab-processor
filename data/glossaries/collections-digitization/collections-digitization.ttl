    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-governance>
    a                        skos:Concept , prov:Plan ;
    skos:prefLabel           "Data Governance"@en ;
    skos:definition          """The control of data entry and maintenance to ensure the data meets defined standards, qualities, or constraints."""@en ;
    skos:notation            "data-governance" ;
    dcterms:identifier       "data-governance" ;
    dcterms:source           "EDAM - Ontology of bioscientific data analysis and data management" ;

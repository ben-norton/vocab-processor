    a                        skos:Concept , prov:Entity ;
    skos:prefLabel           "Pick List"@en ;
    skos:definition          """A graphical user interface device that allows the user to select from a pre-set list of terms. Typically the list of terms is shown when the user clicks on a down arrow next to the entry box for the term."""@en ;
    skos:notation            "pick-list" ;

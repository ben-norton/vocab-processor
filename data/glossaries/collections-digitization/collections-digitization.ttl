    skos:inScheme            <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    skos:topConceptOf        <https://kos.geospecimens.org/kos/glossary/collection-digitization> ;
    reg:status               <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://kos.geospecimens.org/kos/glossary/collection-digitization/term/data-curator>
    a                        skos:Concept , prov:Role ;
    skos:prefLabel           "Data Curator"@en ;
    skos:definition          """Person tasked with reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use, and maintenance within a centralized data store or repository"""@en ;
    skos:notation            "data-curator" ;
    dcterms:identifier       "data-curator" ;
    dcterms:source           "DataCite Metadata Scheme" ;
    dcterms:modified         "2026-03-05"^^xsd:date ;
